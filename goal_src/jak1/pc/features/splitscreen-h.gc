;;-*-Lisp-*-
(in-package goal)

#|
  Local split-screen co-op (PC port addition), header.

  One world simulation, two real players. Player 1 is the original game: *target*, *camera*,
  *math-camera* and friends. Player 2 gets its own copies of those "player globals", and every
  process runs with the globals of the player it belongs to (its "player context"):

  - processes owned by player 2 (its target, daxter, cameras, hud) carry the player2 process-mask
    bit, which children inherit when they are spawned.
  - the kernel switches the context around each process run and each event delivery, see
    *player-context-for-process* in gkernel.gc. World processes (enemies, collectables, ...) run in
    the context of the player closest to them, so the original "*target* is the player" code
    targets the nearest player.
  - the display loop renders view 2 in player 2's context.

  Everything here is inert until co-op is started (see splitscreen.gc). With co-op off, the game
  runs the original single player code paths.
|#

(defconstant COOP_MAX_PLAYERS 2)

(defenum coop-split-layout
  :type uint8
  (side-by-side 0) ;; player 1 left, player 2 right
  (top-bottom 1) ;; player 1 top, player 2 bottom
  )

(deftype coop-settings (structure)
  ((enabled?          symbol) ;; co-op requested (debug menu / progress menu)
   (active?           symbol) ;; player contexts installed, player 2 may exist
   (split?            symbol) ;; rendering two views this frame
   (layout            coop-split-layout)
   (nearest-world?    symbol) ;; world processes use the context of the closest player
   (leash?            symbol) ;; teleport a player that strays too far back to the other one
   (leash-distance    meters) ;; max distance between players before the catch-up teleport
   (near-hysteresis   meters) ;; a world process only switches player when the other is this much closer
   (respawn-delay     time-frame) ;; dead player waits this long before respawning next to the survivor
   (p2-pad            int32) ;; cpad index of player 2
   (frame-views       int32) ;; views rendered in the last frame (for tests / stats)
   (sim-ticks         uint32) ;; simulation ticks since co-op started (for tests / stats)
   (render-passes     uint32) ;; view render passes since co-op started (for tests / stats)
   ))

(define *coop*
  (new 'static
       'coop-settings
       :enabled? #f
       :active? #f
       :split? #f
       :layout (coop-split-layout side-by-side)
       :nearest-world? #t
       :leash? #t
       :leash-distance (meters 60)
       :near-hysteresis (meters 4)
       :respawn-delay (seconds 2)
       :p2-pad 1))

;; index of the player context the code currently runs in. 0 = player 1.
(define *coop-player* 0)

;; The display frame being built. A split-screen frame has one group of buckets per view, laid out
;; in calc-buf as [CALL default-regs][buckets of view 0][CALL default-regs][buckets of view 1].
;; The PC renderer detects the second group and renders each view into its own viewport.
;; Groups are built in chain order (view 0, then view 1): the texture upload tracking assumes the
;; renderer replays uploads in the order the game built them.
(deftype coop-frame (structure)
  ((views  int32) ;; 1 or 2
   (groups (inline-array dma-bucket) 2)))

(define *coop-frame* (new 'static 'coop-frame :views 1))

;; index of the view currently being rendered. 0 = player 1 / full screen.
(define *coop-view* 0)

(defmacro coop-active? ()
  "Is local co-op running?"
  `(-> *coop* active?))

(defmacro coop-process-player (proc)
  "Index of the player that owns this process, 0 for player 1 and everything that isn't player 2's."
  `(if (process-mask? (-> ,proc mask) player2) 1 0))

(defmacro coop-camera-cpad ()
  "The pad that controls the camera of the current player context."
  `(-> *cpad-list* cpads (if (zero? *coop-player*) 0 (-> *coop* p2-pad))))

(defmacro with-coop-player (idx &rest body)
  "Run body in the context of player idx (a no-op without co-op). Used for session level operations
   like start/stop that must always act on player 1, whoever triggered them."
  `(let ((coop-prev-player (if (coop-active?) (coop-switch-context ,idx) -1)))
    (let ((coop-result (begin
                        ,@body)))
      (if (>= coop-prev-player 0) (coop-switch-context coop-prev-player))
      coop-result)))

(defmacro coop-split-frame? ()
  "Is the frame being built a split-screen frame?"
  `(> (-> *coop-frame* views) 1))

(defun coop-view-aspect ((aspect float))
  "The aspect ratio of one view, from the aspect ratio of the whole game area."
  (if (= (-> *coop* layout) (coop-split-layout top-bottom)) (* aspect 2.0) (* aspect 0.5)))

(defmacro with-coop-view-camera (&rest body)
  "Camera updates inside body use the aspect ratio of one view on split-screen frames.
   Co-op always uses the PC (non-vis) projection, which handles any aspect ratio."
  `(let ((coop-saved-aspect (-> *pc-settings* aspect-ratio))
         (coop-saved-use-vis (-> *pc-settings* use-vis?)))
    (when (coop-split-frame?)
      (set! (-> *pc-settings* aspect-ratio) (coop-view-aspect coop-saved-aspect))
      (set! (-> *pc-settings* use-vis?) #f))
    (let ((coop-result (begin
                        ,@body)))
      (set! (-> *pc-settings* aspect-ratio) coop-saved-aspect)
      (set! (-> *pc-settings* use-vis?) coop-saved-use-vis)
      coop-result)))

(define-extern debug-init-buffer (function bucket-id gs-zbuf gs-test none))

(defun coop-frame-start ((frame display-frame))
  "Called by display-frame-start once the main buckets exist: on split-screen frames, add the
   buckets of player 2's view right after them."
  (set! (-> *coop-frame* views) 1)
  (set! (-> *coop-frame* groups 0) (-> frame bucket-group))
  (set! (-> *coop-frame* groups 1) (-> frame bucket-group))
  (when (and (coop-active?) (-> *coop* split?))
    (let* ((buf (-> frame calc-buf))
           (pkt (the-as dma-packet (-> buf base))))
      ;; same header as the first group: reset the GS state
      (set! (-> pkt dma) (new 'static 'dma-tag :id (dma-tag-id call) :addr (the-as int (-> *default-regs-buffer* data))))
      (set! (-> pkt vif0) (new 'static 'vif-tag))
      (set! (-> pkt vif1) (new 'static 'vif-tag))
      (set! (-> buf base) (&+ (the-as pointer pkt) 16))
      (set! (-> *coop-frame* groups 1) (dma-buffer-add-buckets buf BUCKET_COUNT))
      (set! (-> *coop-frame* views) 2)
      ;; the debug bucket setup display-frame-start did for the first group
      (set! (-> frame bucket-group) (-> *coop-frame* groups 1))
      (debug-init-buffer (bucket-id debug-no-zbuf)
                         (new 'static 'gs-zbuf :zbp #x1c0 :psm (gs-psm ct24) :zmsk #x1)
                         (new 'static 'gs-test :zte #x1 :ztst (gs-ztest always)))
      (set! (-> frame bucket-group) (-> *coop-frame* groups 0))))
  (none))

(defun coop-frame-finish ((frame display-frame))
  "Called by display-frame-finish after the first group is finished: finish player 2's buckets
   the same way (a GS reset after each bucket) and stitch them into the chain."
  (when (coop-split-frame?)
    (let ((group (-> *coop-frame* groups 1))
          (global-buf (-> frame global-buf)))
      (dotimes (bucket-idx BUCKET_COUNT)
        (let ((start (-> global-buf base)))
          (let ((pkt (the-as dma-packet (-> global-buf base))))
            (set! (-> pkt dma) (new 'static 'dma-tag :id (dma-tag-id call) :addr (the-as int (-> *default-regs-buffer* data))))
            (set! (-> pkt vif0) (new 'static 'vif-tag :irq #x1))
            (set! (-> pkt vif1) (new 'static 'vif-tag))
            (set! (-> global-buf base) (&+ (the-as pointer pkt) 16)))
          (let ((end (-> global-buf base)))
            (let ((pkt (the-as dma-packet (-> global-buf base))))
              (set! (-> pkt dma) (new 'static 'dma-tag :id (dma-tag-id next)))
              (set! (-> pkt vif0) (new 'static 'vif-tag))
              (set! (-> pkt vif1) (new 'static 'vif-tag))
              (set! (-> global-buf base) (&+ (the-as pointer pkt) 16)))
            (dma-bucket-insert-tag group (the-as bucket-id bucket-idx) start (the-as (pointer dma-tag) end)))))
      ;; the first group's last bucket links to the second group's header, the second group's last
      ;; bucket links to whatever display-frame-finish puts after it (FLUSHE, END).
      (dma-buffer-patch-buckets group BUCKET_COUNT)))
  (none))

(define-extern coop-other-player-target (function process target))

(defun coop-other-player-alive? ((tgt target))
  "Co-op: is the other player in play (spawned, not dying, not waiting to respawn)?
   Always #f without co-op, so the original single player death runs."
  (and (coop-active?)
       (let ((other (coop-other-player-target tgt)))
         (and other
              (not (logtest? (-> other state-flags) (state-flags dying)))
              (-> other state)
              (!= (-> other state name) 'target-death)
              (!= (-> other state name) 'target-coop-respawn)))))

(define *coop-p2-pad-was-valid* #f)

(defun coop-merge-pause-buttons ()
  "Called right before determine-pause-mode: either player can pause the shared session, and
   player 2's controller disconnecting pauses it like player 1's does. Pad 0 is overwritten by
   service-cpads right after, so player 1's gameplay never sees the merged buttons."
  (when (coop-active?)
    (let* ((p1-pad (-> *cpad-list* cpads 0))
           (p2-pad (-> *cpad-list* cpads (-> *coop* p2-pad)))
           (p2-valid (zero? (logand (-> p2-pad valid) 128)))
           (pause-buttons (logand (-> p2-pad button0-rel 0) (pad-buttons start select))))
      (if (and (not p2-valid) *coop-p2-pad-was-valid* (= *master-mode* 'game))
        (set! pause-buttons (logior pause-buttons (pad-buttons select))))
      (set! *coop-p2-pad-was-valid* p2-valid)
      (when (nonzero? pause-buttons)
        (logior! (-> p1-pad button0-abs 0) pause-buttons)
        (logior! (-> p1-pad button0-rel 0) pause-buttons))))
  (none))

(define *coop-grabbed-partner* (the-as handle #f))

(defun coop-grab-other-player ((proc process) (grab symbol))
  "Co-op: cutscenes, conversations and elevators that grab a player hold the other player too.
   Only a partner grabbed this way is released this way (it may be held by something else)."
  (when (and (coop-active?) proc (= (-> proc type) target))
    (let ((other (coop-other-player-target proc)))
      (when other
        (cond
          (grab
           (when (and (not (logtest? (-> other state-flags) (state-flags grabbed dying)))
                      (send-event other 'change-mode 'grab))
             (set! *coop-grabbed-partner* (process->handle other))))
          ((= (handle->process *coop-grabbed-partner*) other)
           (if (= (send-event other 'query 'mode) 'target-grab) (send-event other 'end-mode))
           (set! *coop-grabbed-partner* (the-as handle #f)))))))
  (none))

(defun coop-level-containing ((levels level-group) (pos vector) (skip level))
  "Co-op: the active level (other than skip) whose boxes contain pos, else the closest one."
  (let ((best (the-as level #f))
        (best-dist 0.0))
    (dotimes (i (-> levels length))
      (let ((lev (-> levels level i)))
        (when (and (= (-> lev status) 'active) (!= lev skip))
          (if (point-in-boxes? lev pos) (return lev))
          (let ((d (vector-vector-distance (-> lev bsp bsphere) pos)))
            (when (or (not best) (< d best-dist))
              (set! best lev)
              (set! best-dist d))))))
    best))

(define-extern coop-on-level-leaving (function level none))

(define-extern coop-send-to-other-player (function symbol symbol none))

(defmacro coop-level-leaving (lev)
  "A level is about to be discarded or hidden. Player 2 can't stay in it (streaming follows player 1)."
  `(if (coop-active?) (coop-on-level-leaving ,lev)))

;; defined in splitscreen.gc
(define-extern coop-draw-player2-view (function none))
(define-extern coop-switch-context (function int int))
(define-extern coop-start (function symbol))
(define-extern coop-stop (function none))
(define-extern coop-player-target (function int target))
(define-extern coop-kill-camera-processes (function none))
