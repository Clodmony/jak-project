;;-*-Lisp-*-
(in-package goal)

;; Local split-screen co-op (PC port addition). See splitscreen-h.gc for the overview.

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; player contexts
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(deftype coop-player-context (structure)
  "The values of the engine's single-player globals for one player.
   Processes are stored as handles so a context never hands out a dead process."
  ((target-handle           handle)
   (camera-handle           handle)
   (combiner-handle         handle)
   (math-camera             math-camera)
   (hud-parts               hud-parts)
   (edge-grab-info          edge-grab-info)
   (smush                   smush-control)
   (save-camera-inv-rot     matrix)
   (look-at-data            try-to-look-at-info)
   (camera-base-mode        state)
   (target-pool             process-tree)
   (camera-pool             process-tree)
   (target-dead-pool        dead-pool)
   (camera-dead-pool        dead-pool)
   (camera-master-dead-pool dead-pool)
   (dead-pool-16k           dead-pool)
   (dead-pool-8k            dead-pool))) ;; the zoomer model (one process per player)

(define *coop-context-p1* (new 'global 'coop-player-context))

(define *coop-context-p2* (new 'global 'coop-player-context))

(defmacro coop-context (idx)
  `(if (zero? ,idx) *coop-context-p1* *coop-context-p2*))

;; player 2's copies of the player globals. Allocated once, at load.
(define *coop-p2-math-camera* (new 'global 'math-camera))

(define *coop-p2-hud-parts* (new 'global 'hud-parts))

(define *coop-p2-edge-grab-info* (new 'global 'edge-grab-info))

(define *coop-p2-smush* (set-zero! (new 'global 'smush-control)))

(define *coop-p2-save-camera-inv-rot* (new 'global 'matrix))

(define *coop-p2-look-at-data* (new 'global 'try-to-look-at-info))

;; player 2's processes live in their own process-tree nodes. They are linked into *active-pool*
;; right after the matching player 1 pool, so the order stays targets -> cameras -> display.
;; Their masks carry the player2 bit, which every process spawned into them inherits.
(define *coop-p2-target-pool* (new 'global 'process-tree 'coop-p2-target-pool))

(define *coop-p2-camera-pool* (new 'global 'process-tree 'coop-p2-camera-pool))

(set! (-> *coop-p2-target-pool* mask) (process-mask pause menu progress process-tree player2))

(set! (-> *coop-p2-camera-pool* mask) (process-mask pause menu progress camera process-tree player2))

;; and their own fixed size dead pools, so player 1's pools are unchanged.
(define *coop-p2-target-dead-pool* (new 'global 'dead-pool 1 (* 48 1024) '*coop-p2-target-dead-pool*))

(define *coop-p2-camera-dead-pool* (new 'global 'dead-pool 7 (* 4 1024) '*coop-p2-camera-dead-pool*))

(define *coop-p2-camera-master-dead-pool* (new 'global 'dead-pool 1 (* 8 1024) '*coop-p2-camera-master-dead-pool*))

(define *coop-p2-16k-dead-pool* (new 'global 'dead-pool 1 (* 16 1024) '*coop-p2-16k-dead-pool*))

(define *coop-p2-8k-dead-pool* (new 'global 'dead-pool 1 (* 8 1024) '*coop-p2-8k-dead-pool*))

(defun coop-init-p2-context ()
  "Reset player 2's context to a fresh player with no processes."
  (let ((ctx *coop-context-p2*))
    (set! (-> ctx target-handle) (the-as handle #f))
    (set! (-> ctx camera-handle) (the-as handle #f))
    (set! (-> ctx combiner-handle) (the-as handle #f))
    ;; start from player 1's camera constants (video mode, fog, ...)
    (mem-copy! (the-as pointer *coop-p2-math-camera*) (the-as pointer *math-camera*) (size-of math-camera))
    (set! (-> *coop-p2-math-camera* reset) 1)
    (set! (-> ctx math-camera) *coop-p2-math-camera*)
    (dotimes (i 9)
      (set! (-> *coop-p2-hud-parts* parts i) (the-as (pointer hud) #f)))
    (set! (-> ctx hud-parts) *coop-p2-hud-parts*)
    (set! (-> ctx edge-grab-info) *coop-p2-edge-grab-info*)
    (set-zero! *coop-p2-smush*)
    (set! (-> ctx smush) *coop-p2-smush*)
    (matrix-identity! *coop-p2-save-camera-inv-rot*)
    (set! (-> ctx save-camera-inv-rot) *coop-p2-save-camera-inv-rot*)
    (set! (-> ctx look-at-data) *coop-p2-look-at-data*)
    (set! (-> ctx camera-base-mode) cam-string)
    (set! (-> ctx target-pool) *coop-p2-target-pool*)
    (set! (-> ctx camera-pool) *coop-p2-camera-pool*)
    (set! (-> ctx target-dead-pool) *coop-p2-target-dead-pool*)
    (set! (-> ctx camera-dead-pool) *coop-p2-camera-dead-pool*)
    (set! (-> ctx camera-master-dead-pool) *coop-p2-camera-master-dead-pool*)
    (set! (-> ctx dead-pool-16k) *coop-p2-16k-dead-pool*)
    (set! (-> ctx dead-pool-8k) *coop-p2-8k-dead-pool*))
  (none))

(defmacro coop-process-handle (proc)
  `(let ((p ,proc))
    (if p (process->handle p) (the-as handle #f))))

(defun coop-save-context ((ctx coop-player-context))
  "Store the current values of the player globals into ctx."
  (set! (-> ctx target-handle) (coop-process-handle *target*))
  (set! (-> ctx camera-handle) (coop-process-handle *camera*))
  (set! (-> ctx combiner-handle) (coop-process-handle *camera-combiner*))
  (set! (-> ctx math-camera) *math-camera*)
  (set! (-> ctx hud-parts) *hud-parts*)
  (set! (-> ctx edge-grab-info) *edge-grab-info*)
  (set! (-> ctx smush) *camera-smush-control*)
  (set! (-> ctx save-camera-inv-rot) *save-camera-inv-rot*)
  (set! (-> ctx look-at-data) last-try-to-look-at-data)
  (set! (-> ctx camera-base-mode) *camera-base-mode*)
  (set! (-> ctx target-pool) *target-pool*)
  (set! (-> ctx camera-pool) *camera-pool*)
  (set! (-> ctx target-dead-pool) *target-dead-pool*)
  (set! (-> ctx camera-dead-pool) *camera-dead-pool*)
  (set! (-> ctx camera-master-dead-pool) *camera-master-dead-pool*)
  (set! (-> ctx dead-pool-16k) *16k-dead-pool*)
  (set! (-> ctx dead-pool-8k) *8k-dead-pool*)
  (none))

(defun coop-load-context ((ctx coop-player-context))
  "Make the values in ctx the current player globals."
  (set! *target* (the-as target (handle->process (-> ctx target-handle))))
  (set! *camera* (the-as camera-master (handle->process (-> ctx camera-handle))))
  (set! *camera-combiner* (the-as camera-combiner (handle->process (-> ctx combiner-handle))))
  (set! *math-camera* (-> ctx math-camera))
  (set! *hud-parts* (-> ctx hud-parts))
  (set! *edge-grab-info* (-> ctx edge-grab-info))
  (set! *camera-smush-control* (-> ctx smush))
  (set! *save-camera-inv-rot* (-> ctx save-camera-inv-rot))
  (set! last-try-to-look-at-data (-> ctx look-at-data))
  (set! *camera-base-mode* (the-as (state camera-slave) (-> ctx camera-base-mode)))
  (set! *target-pool* (-> ctx target-pool))
  (set! *camera-pool* (-> ctx camera-pool))
  (set! *target-dead-pool* (-> ctx target-dead-pool))
  (set! *camera-dead-pool* (-> ctx camera-dead-pool))
  (set! *camera-master-dead-pool* (-> ctx camera-master-dead-pool))
  (set! *16k-dead-pool* (-> ctx dead-pool-16k))
  (set! *8k-dead-pool* (-> ctx dead-pool-8k))
  (none))

(defun coop-switch-context ((idx int))
  "Switch the player globals to player idx. Returns the previous player index."
  (let ((prev *coop-player*))
    (when (!= idx prev)
      (coop-save-context (coop-context prev))
      (coop-load-context (coop-context idx))
      (set! *coop-player* idx)
      ;; on split-screen frames, anything a player's processes draw directly (hud text, prompts)
      ;; goes to that player's view
      (when (coop-split-frame?)
        (set! (-> *display* frames (-> *display* on-screen) frame bucket-group) (-> *coop-frame* groups idx))))
    prev))

(defun coop-player-target ((idx int))
  "The target of player idx, or #f. Safe to call from any context."
  (cond
    ((= idx *coop-player*) *target*)
    (else (the-as target (handle->process (-> (coop-context idx) target-handle))))))

(defun coop-other-player-target ((proc process))
  "The target of the player that does not own proc."
  (coop-player-target (- 1 (coop-process-player proc))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; which player does a process belong to?
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; player positions, refreshed once per tick by the manager. A world process runs in the context of
;; the closest player, with some hysteresis so it doesn't flip between players every frame.
(deftype coop-player-cache (structure)
  ((pos   vector 2 :inline)
   (valid symbol 2)))

(define *coop-players* (new 'global 'coop-player-cache))

;; the last touches of world processes by players: a process a player touches runs for that player
(deftype coop-touch-log (structure)
  ((proc   process 16)
   (player int32 16)
   (time   time-frame 16)
   (next   int32)))

(define *coop-touch-log* (new 'global 'coop-touch-log))

(dotimes (i 16)
  (set! (-> *coop-touch-log* proc i) (the-as process #f)))

(set! (-> *coop-touch-log* next) 0)

(defun coop-touch-player ((proc process-drawable))
  "The player who uses proc by touching it: whoever touched it in the last half second; if both did
   (both stand on a platform, both are at a periscope), the one horizontally nearer to it (an
   origin can be far below what is touched), on a tie the one it runs for now. -1 if nobody touched
   it lately (then the coop-touched bit is cleared). Without this a touch decided only until the next
   frame's distance check, and two players touching an object flipped it back and forth (#31)."
  (let ((touched (the-as uint 0)))
    (dotimes (i 16)
      (if (and (= (-> *coop-touch-log* proc i) proc) (not (time-elapsed? (-> *coop-touch-log* time i) (seconds 0.5))))
        (set! touched (logior touched (ash 1 (-> *coop-touch-log* player i))))))
    (case touched
      ((1) 0)
      ((2) 1)
      ((3)
       (let ((d0 (vector-vector-xz-distance (-> proc root trans) (-> *coop-players* pos 0)))
             (d1 (vector-vector-xz-distance (-> proc root trans) (-> *coop-players* pos 1))))
         (cond
           ((< (+ d0 (meters 0.25)) d1) 0)
           ((< (+ d1 (meters 0.25)) d0) 1)
           ((process-mask? (-> proc mask) coop-p2-near) 1)
           (else 0))))
      (else (logclear! (-> proc mask) (process-mask coop-touched)) -1))))

(defun coop-note-touch ((proc process) (player int))
  "A player touched or attacked the world process proc: it runs for that player while they keep
   touching it, and stays with them afterwards until the other player is nearer (coop-touch-player)."
  (let ((i (-> *coop-touch-log* next)))
    (set! (-> *coop-touch-log* proc i) proc)
    (set! (-> *coop-touch-log* player i) player)
    (set! (-> *coop-touch-log* time i) (current-time))
    (set! (-> *coop-touch-log* next) (logand (+ i 1) 15)))
  (let ((user player))
    (when (and (type-type? (-> proc type) process-drawable) (nonzero? (-> (the-as process-drawable proc) root)))
      (logior! (-> proc mask) (process-mask coop-touched))
      (set! user (coop-touch-player (the-as process-drawable proc))))
    (if (= user 1) (logior! (-> proc mask) (process-mask coop-p2-near)) (logclear! (-> proc mask) (process-mask coop-p2-near))))
  (none))

(defun coop-nearest-player-for ((proc process-drawable))
  (let ((root (-> proc root)))
    (cond
      ((not (-> *coop-players* valid 1)) 0)
      ((not (-> *coop-players* valid 0)) 1)
      ((zero? root) 0)
      ;; a player touching it uses it
      ((and (process-mask? (-> proc mask) coop-touched) (>= (coop-touch-player proc) 0))
       (let ((user (coop-touch-player proc)))
         (if (= user 1) (logior! (-> proc mask) (process-mask coop-p2-near)) (logclear! (-> proc mask) (process-mask coop-p2-near)))
         user))
      (else
       (let ((d1 (vector-vector-distance (-> root trans) (-> *coop-players* pos 0)))
             (d2 (vector-vector-distance (-> root trans) (-> *coop-players* pos 1)))
             (margin (-> *coop* near-hysteresis)))
         (cond
           ((process-mask? (-> proc mask) coop-p2-near)
            (cond
              ((< d1 (- d2 margin)) (logclear! (-> proc mask) (process-mask coop-p2-near)) 0)
              (else 1)))
           ((< d2 (- d1 margin)) (logior! (-> proc mask) (process-mask coop-p2-near)) 1)
           (else 0)))))))

(defun coop-owner-player ((proc process))
  "0 or 1 for processes owned by a player (target, daxter, cameras), -1 for world processes."
  (cond
    ((process-mask? (-> proc mask) player2) 1)
    ((logtest? (-> proc mask) (process-mask target sidekick camera)) 0)
    (else -1)))

;; world processes pinned to one player for a while: a power cell's victory runs for the player who
;; took it, a minigame for the player playing it, even if the other player is (or moves) nearer.
;; A pin ends with its process or with coop-unpin.
(deftype coop-pins (structure)
  ((count    int32)
   (proc     handle 4)
   (player   int32 4)
   (minigame symbol 4)
   (alone    symbol 4))) ;; the pin doesn't cover the process's children

(define *coop-pins* (new 'global 'coop-pins))

(set! (-> *coop-pins* count) 0)

(dotimes (i 4)
  (set! (-> *coop-pins* proc i) (the-as handle #f)))

(defun coop-pinned-player ((proc process))
  "The player proc, or its parent, is pinned to, or -1. A pinned process's children (e.g. the one
   drawing a minigame's counters) run for the same player."
  (when (> (-> *coop-pins* count) 0)
    (let ((live 0)
          (parent (if (-> proc parent) (ppointer->process (-> proc parent)))))
      (dotimes (i 4)
        (let ((p (handle->process (-> *coop-pins* proc i))))
          (cond
            ((not p) (set! (-> *coop-pins* proc i) (the-as handle #f)))
            ((or (= p proc) (and (= p parent) (not (-> *coop-pins* alone i)))) (return (-> *coop-pins* player i)))
            (else (+! live 1)))))
      (set! (-> *coop-pins* count) live)))
  -1)

(defun coop-unpin ((proc process))
  "End proc's pin before proc ends (a minigame host that goes back to waiting for a player)."
  (when (> (-> *coop-pins* count) 0)
    (dotimes (i 4)
      (when (= (handle->process (-> *coop-pins* proc i)) proc)
        (set! (-> *coop-pins* proc i) (the-as handle #f))
        (+! (-> *coop-pins* count) -1))))
  (none))

(defun coop-pin-to-player ((proc process) (by handle))
  "Pin proc to the player by is (a target handle), until proc ends. Nothing for anything else.
   Returns #t when proc currently runs in the other player's context: it should (suspend) once, its
   next run is in the right one (switching here would outlive this run of proc)."
  (let ((tgt (handle->process by))
        (wrong #f))
    (when (and (coop-active?) tgt (= (-> tgt type) target))
      (coop-unpin proc) ;; a new pin replaces an old one
      (let ((player (coop-process-player tgt))
            (slot -1))
        (dotimes (i 4)
          (if (and (< slot 0) (not (handle->process (-> *coop-pins* proc i)))) (set! slot i)))
        (when (>= slot 0)
          (set! (-> *coop-pins* proc slot) (process->handle proc))
          (set! (-> *coop-pins* player slot) player)
          (set! (-> *coop-pins* minigame slot) #f)
          (set! (-> *coop-pins* alone slot) #f)
          (+! (-> *coop-pins* count) 1)
          (set! wrong (!= player *coop-player*))
          (format 0 "[coop] player ~D takes ~A~%" (+ player 1) (-> proc name)))))
    wrong))

(defun coop-pin-minigame ((proc process) (by handle))
  "Pin a minigame host (fisherman, Billy, a periscope, the Misty cannon) to the player who starts it.
   Besides running for that player, its grabs (the play-again questions) hold only that player: the
   other one stays free."
  (coop-pin-to-player proc by)
  (dotimes (i 4)
    (if (= (handle->process (-> *coop-pins* proc i)) proc) (set! (-> *coop-pins* minigame i) #t)))
  (none))

(defun coop-pin-alone ((proc process) (by handle))
  "Like coop-pin-to-player, but proc's children keep following the nearest player (a boss's
   minions keep going after the player who is still fighting)."
  (coop-pin-to-player proc by)
  (dotimes (i 4)
    (if (= (handle->process (-> *coop-pins* proc i)) proc) (set! (-> *coop-pins* alone i) #t)))
  (none))

(defun coop-minigame-host? ((proc process))
  "Is proc a minigame host pinned to its player (coop-pin-minigame)?"
  (when (and proc (> (-> *coop-pins* count) 0))
    (dotimes (i 4)
      (if (= (handle->process (-> *coop-pins* proc i)) proc) (return (-> *coop-pins* minigame i)))))
  #f)

(defun coop-player-for-process ((proc process))
  (let ((owner (coop-owner-player proc)))
    (cond
      ((>= owner 0) owner)
      ((>= (coop-pinned-player proc) 0) (coop-pinned-player proc))
      ((and (-> *coop* nearest-world?) (type-type? (-> proc type) process-drawable)) (coop-nearest-player-for (the-as process-drawable proc)))
      (else 0))))

(defun coop-context-for-process ((proc process))
  "Kernel hook: switch to the context proc should run in. Returns the previous context or -1."
  (let ((want (coop-player-for-process proc)))
    (if (= want *coop-player*) -1 (coop-switch-context want))))

(defun coop-context-for-event ((proc process) (from process) (message symbol))
  "Kernel hook: an event is handled in the context of the player that owns the receiver, otherwise
   of the player that sent it, otherwise in the current context.
   A world process that a player touches or attacks also stays with that player afterwards (until the
   other player is near-hysteresis closer): a fuel cell's pickup, a button's elevator ride or an
   enemy's reaction then use the player who caused it (coop-note-touch, coop-touch-player)."
  (let ((want (coop-owner-player proc)))
    (when (and (< want 0) from (type-type? (-> from type) process))
      (set! want (coop-owner-player from))
      (if (and (>= want 0) (or (= message 'touch) (= message 'attack))) (coop-note-touch proc want)))
    (if (or (< want 0) (= want *coop-player*)) -1 (coop-switch-context want))))

(defun coop-context-restore ((idx int))
  "Kernel hook: switch back to a context returned by the hooks above."
  (coop-switch-context idx)
  (none))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; process tree helpers
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun coop-link-tree-after ((node process-tree) (sibling process-tree))
  "Insert node into sibling's parent, right after sibling (so it runs after it)."
  (when (not (-> node parent))
    (set! (-> node parent) (-> sibling parent))
    (set! (-> node brother) (-> sibling brother))
    (set! (-> sibling brother) (the-as (pointer process-tree) (-> node ppointer))))
  (none))

(define *coop-search-player* 0)

(defun coop-kill-by-name-in-current-player ((name symbol))
  "Like kill-by-name on *active-pool*, but only for processes of the current player context."
  (set! *global-search-name* name)
  (set! *coop-search-player* *coop-player*)
  (let ((proc (the-as process #f)))
    (while (set! proc
                 (search-process-tree *active-pool*
                                      (lambda ((var process))
                                        (and (name= (-> var name) *global-search-name*)
                                             (= (coop-process-player var) *coop-search-player*)))))
      (deactivate proc)))
  (none))

(defun coop-kill-camera-processes ()
  "cam-stop helper: kill the camera rig of the current player context only."
  (coop-kill-by-name-in-current-player 'camera-master)
  (coop-kill-by-name-in-current-player 'camera-slave)
  (coop-kill-by-name-in-current-player 'camera-combiner)
  (none))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; player 2 spawn / respawn
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define *coop-p2-continue* (new 'global 'continue-point))

(defun coop-target-ready? ((tgt target))
  "Is this player in normal control, standing on safe ground?"
  (and tgt
       (not (logtest? (-> tgt state-flags) (state-flags grabbed dying)))
       (-> tgt state)
       (not (or (= (-> tgt state name) 'target-continue)
                (= (-> tgt state name) 'target-coop-spawn)
                (= (-> tgt state name) 'target-coop-respawn)
                (= (-> tgt state name) 'target-death)))
       ;; onsurf too: a flut flut standing in shallow water (Boggy Swamp) is onsurf but never onground
       (logtest? (-> tgt control status) (cshape-moving-flags onground onsurf))))

(defun coop-safe-position-near ((tgt target) (result vector))
  "A safe position next to tgt: its last known safe ground, or its own position when that is unset or
   stale (it isn't updated on platforms, elevators, boats or water, and can be far behind)."
  (let ((safe (-> tgt control last-known-safe-ground)))
    (if (or (and (= (-> safe x) 0.0) (= (-> safe y) 0.0) (= (-> safe z) 0.0))
            (logtest? (-> tgt control status) (cshape-moving-flags t-act on-water))
            (< (meters 8) (vector-vector-distance safe (-> tgt control trans))))
      (set! (-> result quad) (-> tgt control trans quad))
      (set! (-> result quad) (-> safe quad))))
  ;; step to the side so the two players don't overlap.
  ;; a spot is used only if the way there is clear and it has ground at about the same height.
  (let ((side (vector-x-quaternion! (new 'stack-no-clear 'vector) (-> tgt control quat-for-control)))
        (fwd (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> tgt control quat-for-control)))
        (from (new 'stack-no-clear 'vector))
        (cand (new 'stack-no-clear 'vector))
        (move (new 'stack-no-clear 'vector))
        (tri (new 'stack-no-clear 'collide-tri-result))
        (found #f))
    (set! (-> side y) 0.0)
    (vector-normalize! side (meters 1.5))
    (set! (-> fwd y) 0.0)
    (vector-normalize! fwd (meters -1.5))
    (set! (-> from quad) (-> result quad))
    (+! (-> from y) (meters 1))
    (dotimes (i 3)
      (when (not found)
        (vector+! cand from (case i ((0) side) ((1) (vector-negate! move side)) (else fwd)))
        (vector-! move cand from)
        (when (< (fill-and-probe-using-line-sphere *collide-cache* from move (meters 0.4) (collide-kind background) tgt tri
                                                   (new 'static 'pat-surface :noentity #x1))
                 0.0)
          (set-vector! move 0.0 (meters -3) 0.0 1.0)
          (when (and (>= (fill-and-probe-using-line-sphere *collide-cache* cand move (meters 0.2) (collide-kind background) tgt tri
                                                           (new 'static 'pat-surface :noentity #x1))
                         0.0)
                     (< (fabs (- (-> tri intersect y) (-> result y))) (meters 1)))
            (set! (-> result quad) (-> tri intersect quad))
            (set! found #t))))))
  (+! (-> result y) (meters 0.5))
  result)

(defun coop-spawn-player2 ((pos vector))
  "Spawn player 2's target at pos, in player 2's context."
  (let ((prev (coop-switch-context 1)))
    (set! (-> *coop-p2-continue* trans quad) (-> pos quad))
    (let ((p1 (coop-player-target 0)))
      (if p1
        (quaternion-copy! (-> *coop-p2-continue* quat) (-> p1 control quat-for-control))
        (quaternion-identity! (-> *coop-p2-continue* quat))))
    (let ((proc (process-spawn target
                               :init init-target
                               *coop-p2-continue*
                               :from *target-dead-pool*
                               :to *target-pool*
                               :stack *kernel-dram-stack*)))
      (set! *target* (if proc (the-as target (-> proc 0 self)) (the-as target #f))))
    (format 0 "[coop] player 2 spawned: ~A~%" *target*)
    (coop-switch-context prev))
  (none))

(defun coop-despawn-player2 ()
  "Kill player 2's target and camera rig."
  ;; world processes that run later this tick must not pick player 2
  (set! (-> *coop-players* valid 1) #f)
  (let ((prev (coop-switch-context 1)))
    (when *target*
      (deactivate *target*)
      (set! *target* #f))
    (coop-kill-camera-processes)
    (set! *camera* #f)
    (set! *camera-combiner* #f)
    (coop-switch-context prev))
  (none))

;; player 2's spawn: a light version of target-continue that doesn't touch session state
;; (load state, continue point, settings, player 1's camera).
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; vehicles (zoomer and flut flut): both players ride their own, progress needs both
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define-extern coop-player-in-play? (function target basic))

(deftype coop-racer-state (structure)
  ((pad        handle)       ;; the zoomer or flut flut pad the players got on at (a handle: in a structure, not a symbol)
   (left-pad   symbol 2)   ;; has each player moved away from the pad since they last got on
   (checkpoint continue-point 2)   ;; the last checkpoint each player drove past (where they respawn)
   (died-racing symbol 2)))        ;; did each player's last death happen on a zoomer or flut flut

(define *coop-racer* (new 'global 'coop-racer-state))

(set! (-> *coop-racer* pad) (the-as handle #f))

(set! (-> *coop-racer* left-pad 0) #f)

(set! (-> *coop-racer* left-pad 1) #f)

(set! (-> *coop-racer* checkpoint 0) #f)

(set! (-> *coop-racer* checkpoint 1) #f)

(set! (-> *coop-racer* died-racing 0) #f)

(set! (-> *coop-racer* died-racing 1) #f)

(defun coop-player-racing? ((tgt target))
  (and tgt (logtest? (-> tgt control root-prim prim-core action) (collide-action racer))))

(defun coop-player-on-flut? ((tgt target))
  (and tgt (logtest? (-> tgt control root-prim prim-core action) (collide-action flut))))

(defun coop-player-riding? ((tgt target))
  "On a zoomer or a flut flut."
  (and tgt (logtest? (-> tgt control root-prim prim-core action) (collide-action racer flut))))

(defun coop-flut-rider ()
  "For the flut flut pads: a player riding a flut flut, or #f. Without co-op that is *target*. With
   co-op it is any player (the one nearest to the pad first), so a pad keeps its riding state (and the
   walls that keep the flut flut in its area) while either player rides."
  (cond
    ((coop-player-on-flut? *target*) *target*)
    ((not (coop-active?)) (the-as target #f))
    ((coop-player-on-flut? (coop-player-target 0)) (coop-player-target 0))
    ((coop-player-on-flut? (coop-player-target 1)) (coop-player-target 1))
    (else (the-as target #f))))

(defun coop-vehicle-section? ()
  "Is a zoomer or flut flut section going on (a player rides from the pad they got on at)?"
  (and (handle->process (-> *coop-racer* pad))
       (or (coop-player-riding? (coop-player-target 0)) (coop-player-riding? (coop-player-target 1)))))

(defun coop-flut-section? ()
  "Is the vehicle section going on a flut flut one?"
  (and (coop-vehicle-section?) (= (-> (handle->process (-> *coop-racer* pad)) type symbol) 'flutflut)))

(defun coop-zoomer-section? ()
  (and (coop-vehicle-section?) (not (coop-flut-section?))))

(defun coop-racer-note-mount ((tgt target))
  (if tgt (set! (-> *coop-racer* left-pad (coop-process-player tgt)) #f))
  (none))

(defun coop-racer-may-get-off? ((proc process))
  "May the zoomer pad end proc's ride? Only once the rider has driven away from it since getting on
   (like the pad's own pickup state): a respawn puts the rider back onto the pad they got on at."
  (or (not (coop-active?))
      (not proc)
      (!= (-> proc type) target)
      (-> *coop-racer* left-pad (coop-process-player proc))))

(defun coop-racer-checkpoint-near ((pos vector))
  "The continue point of an active level within 30 m of pos, or #f."
  (dotimes (i (-> *level* length))
    (let ((lev (-> *level* level i)))
      (when (= (-> lev status) 'active)
        (let ((cps (-> lev info continues)))
          (while (not (null? cps))
            (let ((cp (the-as continue-point (car cps))))
              (if (< (vector-vector-distance pos (-> cp trans)) (meters 30)) (return cp)))
            (set! cps (cdr cps)))))))
  (the-as continue-point #f))

(defun coop-racer-checkpoint ((idx int))
  "Where player idx respawns in a zoomer section: their own last checkpoint. The game's continue
   point follows player 1 only, so it can be ahead of or behind player 2."
  (if (-> *coop-racer* checkpoint idx) (-> *coop-racer* checkpoint idx) (-> *game-info* current-continue)))

(defun coop-racer-update ()
  "Once per tick: note which riders have moved more than 6 m away from the pad, and the last
   checkpoint each zoomer rider drove past (a flut flut rider respawns at the pad)."
  (let ((pad (the-as process-drawable (handle->process (-> *coop-racer* pad)))))
    (when pad
      (dotimes (i 2)
        (let ((tgt (coop-player-target i)))
          ;; only while riding: getting on moves the rider onto the pad first
          (when (and (coop-player-riding? tgt)
                     (!= (-> tgt state name) 'target-racing-start)
                     (!= (-> tgt state name) 'target-racing-get-on)
                     (!= (-> tgt state name) 'target-flut-start)
                     (!= (-> tgt state name) 'target-flut-get-on))
            (if (< (meters 6) (vector-vector-distance (-> tgt control trans) (-> pad root trans)))
              (set! (-> *coop-racer* left-pad i) #t))
            (let ((cp (if (coop-player-racing? tgt) (coop-racer-checkpoint-near (-> tgt control trans)))))
              (when (and cp (!= cp (-> *coop-racer* checkpoint i)))
                (set! (-> *coop-racer* checkpoint i) cp)
                (format 0 "[coop] player ~D checkpoint ~A~%" (+ i 1) (-> cp name)))))))))
  (none))

(defun coop-racer-mount-other ((pad process) (mounted target))
  "A player got on a zoomer or flut flut at pad: the other player gets their own next to them, so
   both ride at the same time."
  (when (and (coop-active?) mounted)
    (set! (-> *coop-racer* pad) (process->handle pad))
    ;; a new zoomer section: both start from the game's checkpoint
    (set! (-> *coop-racer* checkpoint 0) (-> *game-info* current-continue))
    (set! (-> *coop-racer* checkpoint 1) (-> *game-info* current-continue))
    (coop-racer-note-mount mounted)
    (let ((other (coop-other-player-target mounted)))
      (when (and other (coop-player-in-play? other) (not (coop-player-riding? other)))
        (move-to-point! (-> other control) (coop-safe-position-near mounted (new 'stack-no-clear 'vector)))
        (coop-racer-note-mount other)
        (send-event other 'change-mode (if (= (-> pad type symbol) 'flutflut) 'flut 'racing) pad))))
  (none))

(defun coop-racer-dismount-other ((dismounted process))
  "A player got off at a zoomer pad (end of a zoomer section): the other player gets off too."
  (when (and (coop-active?) dismounted (= (-> dismounted type) target))
    (let ((other (coop-other-player-target dismounted)))
      (if (coop-player-racing? other) (send-event other 'end-mode))))
  (none))

(deftype coop-pad-search (structure)
  ((pos  vector :inline)
   (best process)
   (dist float)
   (kind symbol)))

;; lambdas don't capture locals, so the nearest-pad search keeps its state here
(define *coop-pad-search* (new 'global 'coop-pad-search))

(defun coop-powerup-player-near ((pos vector) (radius float) (kind pickup-type))
  "A player within radius of pos who has the powerup kind (e.g. blue eco), or #f. Without co-op
   only *target* counts. For world objects that react to the player carrying an eco: the one
   nearest to them (*target* in their context) may not be the one carrying it."
  (dotimes (i (if (coop-active?) 2 1))
    (let ((tgt (if (coop-active?) (coop-player-target i) *target*)))
      (if (and tgt
               (>= radius (vector-vector-distance pos (-> tgt control trans)))
               (send-event tgt 'query 'powerup kind))
        (return tgt))))
  (the-as target #f))

;; per race ring: player 2's hips last frame (the ring itself keeps player 1's) and, for the
;; every-ring option, which players flew through it since it lit up
(deftype coop-ring-hips (structure)
  ((owner  process 8)
   (next   int32)
   (passed uint8 8)       ;; bit per player
   (lit    time-frame 8)  ;; the ring's state-time when the bits were recorded (it lit up again: reset)
   (hips   vector 8 :inline)))

(define *coop-ring-hips* (new 'global 'coop-ring-hips))

(dotimes (i 8)
  (set! (-> *coop-ring-hips* owner i) (the-as process #f)))

(set! (-> *coop-ring-hips* next) 0)

(defun coop-ring-slot ((ring process))
  "The slot of this ring (a new one starts with player 2 far away, so their first frame doesn't count)."
  (dotimes (i 8)
    (if (= (-> *coop-ring-hips* owner i) ring)
      (return i)))
  (let ((i (-> *coop-ring-hips* next)))
    (set! (-> *coop-ring-hips* next) (mod (+ i 1) 8))
    (set! (-> *coop-ring-hips* owner i) ring)
    (set! (-> *coop-ring-hips* passed i) (the-as uint 0))
    (set! (-> *coop-ring-hips* lit i) (-> (the-as process-drawable ring) state-time))
    (set-vector! (-> *coop-ring-hips* hips i) 0.0 (meters 100000) 0.0 1.0)
    i))

(defun coop-ring-crossed? ((ring process) (cyl cylinder-flat) (hips0 vector))
  "Race rings: does the ring count as flown through this frame? hips0 holds player 1's hips from the
   last frame (the ring's own field), player 2's are kept here; both are updated. Each player's own
   path is checked: with one position for both, a switch between the players drew a line from one
   to the other that could cross the ring. A jump of more than 10 m (a respawn) doesn't count.
   By default either player flying through counts. With the every-ring option the ring counts once
   every player in play flew through it since it lit up. Without co-op only *target*, in hips0."
  (let* ((coop (coop-active?))
         (slot (if coop (coop-ring-slot ring) 0))
         (hips1 (if coop (-> *coop-ring-hips* hips slot) hips0))
         (crossed #f))
    (when (and coop (!= (-> *coop-ring-hips* lit slot) (-> (the-as process-drawable ring) state-time)))
      (set! (-> *coop-ring-hips* lit slot) (-> (the-as process-drawable ring) state-time))
      (set! (-> *coop-ring-hips* passed slot) (the-as uint 0)))
    (dotimes (i (if coop 2 1))
      (let ((tgt (if coop (coop-player-target i) *target*))
            (hips (if (zero? i) hips0 hips1)))
        (when tgt
          (let ((dir (new 'stack-no-clear 'vector)))
            (set! (-> dir quad) (-> hips quad))
            (vector<-cspace! hips (-> tgt node-list data 26))
            (vector-! dir dir hips)
            (when (and (< (vector-length dir) (meters 10)) (>= (ray-flat-cyl-intersect cyl hips dir) 0.0))
              (set! crossed #t)
              (when (and coop (not (logtest? (-> *coop-ring-hips* passed slot) (ash 1 i))))
                (logior! (-> *coop-ring-hips* passed slot) (ash 1 i))
                (when (-> *coop* every-ring?)
                  (sound-play "close-racering")
                  (format 0 "[coop] player ~D flew through ~A~%" (+ i 1) (-> ring name)))))))))
    (when (and coop (-> *coop* every-ring?))
      ;; every player in play must have flown through (a player waiting to respawn doesn't hold it up)
      (set! crossed (nonzero? (-> *coop-ring-hips* passed slot)))
      (dotimes (i 2)
        (let ((tgt (coop-player-target i)))
          (if (and (coop-player-in-play? tgt) (not (logtest? (-> *coop-ring-hips* passed slot) (ash 1 i))))
            (set! crossed #f)))))
    crossed))

(defun coop-racer-pad-near ((pos vector) (radius float) (kind symbol))
  "The pad of type kind (racer or flutflut) closest to pos within radius, or #f."
  (set! (-> *coop-pad-search* pos quad) (-> pos quad))
  (set! (-> *coop-pad-search* best) #f)
  (set! (-> *coop-pad-search* dist) radius)
  (set! (-> *coop-pad-search* kind) kind)
  (iterate-process-tree *entity-pool*
                        (lambda ((p process))
                          (when (= (-> p type symbol) (-> *coop-pad-search* kind))
                            (let ((d (vector-vector-distance (-> (the-as process-drawable p) root trans) (-> *coop-pad-search* pos))))
                              (when (< d (-> *coop-pad-search* dist))
                                (set! (-> *coop-pad-search* dist) d)
                                (set! (-> *coop-pad-search* best) p))))
                          #t)
                        *kernel-context*)
  (-> *coop-pad-search* best))

(defun coop-racer-note-death ((tgt target))
  "tgt died on a zoomer or flut flut while the other player rides on: the respawn puts them back on one."
  (set! (-> *coop-racer* died-racing (coop-process-player tgt)) (if (coop-player-on-flut? tgt) 'flutflut 'racer))
  (none))

(defun coop-racer-remount ((tgt target) (kind symbol))
  "After a spawn or a vehicle death, called from tgt's own code: tgt gets a vehicle of kind (racer or
   flutflut, after a death on one), or with kind #f the vehicle the other player rides from the
   section's pad, if any.
   Getting on moves the rider onto the pad it uses, so use the pad at the respawn point; with no pad
   nearby a zoomer rider gets on where they stand. A flut flut always needs a pad (its model is found
   through the pad's level), away from it the rider gets on where they stand (coop-flut-mount-at-pad?).
   (The spawn/respawn states don't take 'change-mode events, so this switches state directly.)"
  (let* ((other (coop-other-player-target tgt))
         (section-pad (handle->process (-> *coop-racer* pad)))
         (want (cond
                 (kind kind)
                 ((not (and section-pad (coop-player-riding? other))) #f)
                 ((coop-player-on-flut? other) 'flutflut)
                 (else 'racer))))
    (when (and want (not (coop-player-riding? tgt)))
      (let* ((flut? (= want 'flutflut))
             (pad (coop-racer-pad-near (-> tgt control trans) (if flut? (meters 8) (meters 30)) want)))
        (when (and flut? (not pad))
          (set! pad (if (and section-pad (= (-> section-pad type symbol) 'flutflut))
                      section-pad
                      (coop-racer-pad-near (-> tgt control trans) (meters 100000) 'flutflut))))
        (cond
          ((not flut?)
           (coop-racer-note-mount tgt)
           (go-process tgt target-racing-start (if pad (process->handle pad) (the-as handle #f))))
          (pad
           (coop-racer-note-mount tgt)
           (go-process tgt target-flut-start (process->handle pad)))))))
  (none))

(defun coop-flut-mount-at-pad? ((pad process-drawable) (tgt target))
  "Does tgt get onto the flut flut at pad (moving onto it), or where they stand? Only a co-op
   (re)spawn more than 8 m from the pad gets on where they stand."
  (or (not (coop-active?)) (>= (meters 8) (vector-vector-distance (-> tgt control trans) (-> pad root trans)))))

(defun coop-racer-respawn-point ((idx int) (pos vector) (quat quaternion))
  "Where player idx respawns after dying on a vehicle: a flut flut rider at the pad they got on at,
   a zoomer rider at their own last checkpoint. Returns the name of the place."
  (let ((pad (the-as process-drawable (handle->process (-> *coop-racer* pad)))))
    (cond
      ((and pad (= (-> pad type symbol) 'flutflut))
       (set! (-> pos quad) (-> pad root trans quad))
       (quaternion-copy! quat (-> pad root quat))
       (the-as string (-> pad name)))
      (else
       (let ((cp (coop-racer-checkpoint idx)))
         (set! (-> pos quad) (-> cp trans quad))
         (quaternion-copy! quat (-> cp quat))
         (-> cp name))))))

(defun coop-elevator-called? ((plat process-drawable) (height float))
  "A platform waiting at the top (Snowy's flut flut elevator to the fort) goes back down for a player
   below height who isn't jumping. Without co-op that is *target* (the original check). With co-op it
   is either player on foot, and only while no player is within 5 m of the platform: the other player
   may have just ridden it up."
  (when (coop-active?)
    (dotimes (i 2)
      (let ((tgt (coop-player-target i)))
        (if (and (coop-player-in-play? tgt) (>= (meters 5) (vector-vector-distance (-> tgt control trans) (-> plat root trans))))
          (return #f)))))
  (dotimes (i (if (coop-active?) 2 1))
    (let ((tgt (if (coop-active?) (coop-player-target i) *target*)))
      (if (and tgt
               (or (not (coop-active?)) (and (coop-player-in-play? tgt) (not (coop-player-riding? tgt))))
               (>= height (-> tgt control trans y))
               (not (and (logtest? (-> tgt control mod-surface flags) (surface-flags jump))
                         (not (logtest? (-> tgt control status) (cshape-moving-flags onsurf))))))
        (return #t))))
  #f)

(defun coop-bring-onto-platform ((plat process-drawable) (tgt target))
  "A ride that takes one player where the other can't follow (the jungle elevator down to the plant
   boss): the other player, if in play and not on the platform already, is put onto it on the far
   side from tgt, and loses their eco like tgt does."
  (when (and (coop-active?) tgt)
    (let ((other (coop-other-player-target tgt)))
      (when (and (coop-player-in-play? other)
                 (or (< (meters 4) (vector-vector-xz-distance (-> other control trans) (-> plat root trans)))
                     (< (meters 2.5) (fabs (- (-> other control trans y) (-> plat root trans y))))))
        (let ((pos (new 'stack-no-clear 'vector)))
          (vector-! pos (-> plat root trans) (-> tgt control trans))
          (set! (-> pos y) 0.0)
          (if (< (vector-length pos) (meters 0.5))
            (set-vector! pos (meters 1.5) 0.0 0.0 1.0)
            (vector-normalize! pos (meters 1.5)))
          (vector+! pos pos (-> plat root trans))
          (+! (-> pos y) (meters 1))
          (set! (-> other control transv quad) (the-as uint128 0))
          (move-to-point! (-> other control) pos)
          (set! (-> other control highest-jump-mark quad) (-> pos quad))
          (format 0 "[coop] player ~D rides along on ~A~%" (+ 1 (coop-process-player other)) (-> plat name))))
      (if (coop-player-in-play? other) (send-event other 'reset-pickup 'eco))))
  (none))

(defun coop-move-other-rider ((plat process-drawable) (delta vector))
  "A platform that moves *target* with it by hand (the jungle elevator, too fast for riding) moves the
   other player standing on it by the same amount."
  (when (coop-active?)
    (let ((other (coop-player-target (- 1 *coop-player*))))
      (when (and (coop-player-in-play? other)
                 (>= (meters 5) (vector-vector-xz-distance (-> other control trans) (-> plat root trans)))
                 (>= (meters 4) (fabs (- (-> other control trans y) (-> plat root trans y)))))
        (move-by-vector! (-> other control) delta)
        (send-event other 'reset-height))))
  (none))

(defun coop-flut-cell-ready? ((cell process-drawable))
  "In a flut flut section a power cell waits for both players: it can be taken once every player in
   play is within 30 m of it. Always #t otherwise."
  (or (not (coop-active?))
      (not (coop-flut-section?))
      (let ((ready #t))
        (dotimes (i 2)
          (let ((tgt (coop-player-target i)))
            (if (and (coop-player-in-play? tgt) (< (meters 30) (vector-vector-distance (-> tgt control trans) (-> cell root trans))))
              (set! ready #f))))
        ready)))

(defun coop-racer-finish-ready? ((pad process-drawable))
  "A zoomer finish pad only hands out its reward once every player has arrived (within 30 m)."
  (or (not (coop-active?))
      (let ((ready #t))
        (dotimes (i 2)
          (let ((tgt (coop-player-target i)))
            (if (and tgt (< (meters 30) (vector-vector-distance (-> tgt control trans) (-> pad root trans)))) (set! ready #f))))
        ready)))

(defun coop-player-warping-in? ((tgt target))
  "Is tgt coming out of a warp gate?"
  (and tgt (-> tgt state) (= (-> tgt state name) 'target-warp-in)))

(defstate target-coop-spawn (target)
  :event target-generic-event-handler
  :exit
    (behavior ()
      ;; set by init-target, target-continue's exit normally removes them
      (remove-setting! 'allow-pause)
      (remove-setting! 'allow-progress))
  :code
    (behavior ((arg0 vector))
      (set-time! (-> self state-time))
      (reset-target-state #t)
      (target-exit)
      (ja-channel-set! 0)
      (quaternion-copy! (-> self control quat-for-control) (-> *coop-p2-continue* quat))
      (move-to-point! (-> self control) arg0)
      (rot->dir-targ! (-> self control))
      (set! (-> self control camera-pos quad) (-> self control trans quad))
      ;; our own camera rig. We are a player 2 process, so this runs in player 2's context.
      (cam-start #f)
      (suspend)
      (suspend)
      ;; start the camera where player 1's camera is relative to player 1
      (let ((p1 (coop-player-target 0))
            (p1-cam (the-as camera-combiner (handle->process (-> *coop-context-p1* combiner-handle)))))
        (when (and *camera-combiner* p1 p1-cam)
          (vector+! (-> *camera-combiner* trans) (-> self control trans) (vector-! (new 'stack-no-clear 'vector) (-> p1-cam trans) (-> p1 control trans)))
          (matrix-copy! (-> *camera-combiner* inv-camera-rot) (-> p1-cam inv-camera-rot))))
      (send-event *camera* 'change-target self)
      (send-event *camera* 'no-intro)
      (send-event *camera* 'clear-entity)
      (send-event *camera* 'force-blend 0)
      (send-event *camera* 'change-state cam-fixed 0)
      (send-event *camera* 'change-state cam-string 0)
      (ja-channel-set! 1)
      (ja :group! eichar-stance-loop-ja)
      (suspend)
      (logior! (-> self control status) (cshape-moving-flags onsurf onground tsurf))
      (coop-racer-remount self #f)
      ;; player 1 is coming out of a warp gate: come out of it too, landing beside them
      (let ((p1 (coop-player-target 0)))
        (when (coop-player-warping-in? p1)
          (let ((gate (new 'stack-no-clear 'vector))
                (dest (new 'stack-no-clear 'vector)))
            (vector+! gate (-> p1 control unknown-vector102) (new 'static 'vector :y 4096.0 :w 1.0))
            (vector+! dest (-> p1 control unknown-vector103) (new 'static 'vector :x 6144.0 :w 1.0))
            (format 0 "[coop] player 2 comes out of the warp gate~%")
            (go target-warp-in gate dest))))
      (go target-stance)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; level streaming
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun coop-on-level-leaving ((lev level))
  "Level loading follows player 1. Called right before lev is discarded or hidden: if player 2 is
   in it (and not in the other displayed level), bring player 2 to player 1 before its floor goes."
  (let ((p1 (coop-player-target 0))
        (p2 (coop-player-target 1)))
    (when p2
      (let ((pos (-> p2 control trans))
            (safe-elsewhere #f))
        (dotimes (i (-> *level* length))
          (let ((other (-> *level* level i)))
            (if (and (!= other lev) (= (-> other status) 'active) (-> other display?) (point-in-boxes? other pos))
              (set! safe-elsewhere #t))))
        (when (and (not safe-elsewhere) (= (coop-level-containing *level* pos (the-as level #f)) lev))
          (format 0 "[coop] level ~A goes away under player 2, bringing player 2 to player 1~%" (-> lev name))
          (coop-despawn-player2)
          ;; respawn now if player 1 is in control and the spot isn't in the leaving level too,
          ;; otherwise the manager respawns player 2 once player 1 is ready
          (when (coop-target-ready? p1)
            (let ((dest (coop-safe-position-near p1 (new 'stack-no-clear 'vector))))
              (if (= (coop-level-containing *level* dest (the-as level #f)) lev) (set! (-> dest quad) (-> p1 control trans quad)))
              (coop-spawn-player2 dest)))))))
  (none))

(defun coop-send-to-other-player ((msg symbol) (arg symbol))
  "Level lifecycle events reach the current player's camera and target directly (*camera*, *target*),
   send them to the other player's too."
  (let* ((other (- 1 *coop-player*))
         (cam (handle->process (-> (coop-context other) camera-handle)))
         (tgt (coop-player-target other)))
    (if cam (send-event cam msg arg))
    (if tgt (send-event tgt msg arg)))
  (none))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; death and respawn
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun coop-set-hidden ((tgt target) (hidden symbol))
  "Hide or show a player and their daxter."
  (let ((sidekick (if (-> tgt sidekick) (ppointer->process (-> tgt sidekick)))))
    (cond
      (hidden
       (logior! (-> tgt draw status) (draw-status hidden))
       (if sidekick (logior! (-> (the-as process-drawable sidekick) draw status) (draw-status hidden))))
      (else
       (logclear! (-> tgt draw status) (draw-status hidden))
       (if sidekick (logclear! (-> (the-as process-drawable sidekick) draw status) (draw-status hidden))))))
  (none))

;; a player that died while the other one is still playing. Entered from target-death instead of
;; the world reset. Waits respawn-delay, then respawns at the other player's last safe ground.
;; If the other player goes down meanwhile, their target-death does the shared checkpoint reload.
(defstate target-coop-respawn (target)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('attack 'attack-or-shove 'attack-invinc 'shove 'touched 'get-pickup) #f)
        (else (target-generic-event-handler proc argc message block))))
  :exit
    (behavior ()
      (coop-set-hidden self #f)
      (restore-collide-with-as (-> self control)))
  :code
    (behavior ()
      (set-time! (-> self state-time))
      (coop-set-hidden self #t)
      (clear-collide-with-as (-> self control))
      (set! (-> self control transv quad) (the-as uint128 0))
      (suspend-for (-> *coop* respawn-delay))
      ;; wait for the other player to stand somewhere safe (not after a vehicle death or in a zoomer
      ;; section: there the dead player goes back to their last checkpoint alone and rides that part again)
      (let ((other (coop-other-player-target self))
            (racing-death (-> *coop-racer* died-racing (coop-process-player self))))
        (until (or (not (coop-active?)) racing-death (coop-zoomer-section?) (coop-target-ready? other))
          (suspend)
          (set! other (coop-other-player-target self)))
        ;; co-op was stopped while we waited: finish the original single player death
        (when (not (coop-active?))
          (coop-set-hidden self #f)
          (initialize! (-> self game) 'dead (the-as game-save #f) (the-as string #f))
          (set-time! (-> self state-time))
          (anim-loop))
        (let ((pos (new 'stack-no-clear 'vector))
              (quat (new 'stack-no-clear 'quaternion))
              (at-checkpoint (or racing-death (coop-zoomer-section?))))
          (cond
            (at-checkpoint
             (let ((place (coop-racer-respawn-point (coop-process-player self) pos quat)))
               (format 0 "[coop] player ~D respawns at the checkpoint ~A~%" (+ 1 (coop-process-player self)) place)))
            (else
             (coop-safe-position-near other pos)
             (quaternion-copy! quat (-> other control quat-for-control))
             (format 0 "[coop] player ~D respawns next to player ~D~%" (+ 1 (coop-process-player self)) (- 2 (coop-process-player self)))))
          (reset! (-> self fact) 'health)
          (reset! (-> self fact) 'eco)
          ;; a death that drove our root joint (eaten by the Dark Eco Plant) left it attached to the
          ;; killer; the camera follows that joint. Back to init-target's setup, daxter on our shoulder.
          (let ((root (-> self node-list data 0)))
            (set! (-> root param0) cspace<-transformq+trans!)
            (set! (-> root param1) (the-as basic (-> self control trans)))
            (set! (-> root param2) (the-as basic (-> self control cspace-offset))))
          (send-event (ppointer->process (-> self sidekick)) 'matrix 'normal)
          (reset-target-state #t)
          (target-exit)
          (quaternion-copy! (-> self control quat-for-control) quat)
          (move-to-point! (-> self control) pos)
          (rot->dir-targ! (-> self control))
          (set! (-> self control camera-pos quad) (-> self control trans quad))
          (set! (-> self control last-known-safe-ground quad) (-> pos quad))))
      ;; our own camera (we run in our own player context)
      (send-event *camera* 'change-state cam-string 0)
      (send-event *camera* 'teleport)
      (coop-set-hidden self #f)
      (restore-collide-with-as (-> self control))
      (target-timed-invulnerable (seconds 2) self)
      (ja-channel-set! 1)
      (ja :group! eichar-stance-loop-ja)
      (suspend)
      (logior! (-> self control status) (cshape-moving-flags onsurf onground tsurf))
      ;; back on a zoomer or flut flut after a death on one (also when the other player got off
      ;; meanwhile). A player who got off at a zoomer pad and died on foot stays on foot; in a flut flut
      ;; section a player who died on foot comes back next to the other one, on a flut flut too.
      (cond
        ((-> *coop-racer* died-racing (coop-process-player self))
         (let ((kind (-> *coop-racer* died-racing (coop-process-player self))))
           (set! (-> *coop-racer* died-racing (coop-process-player self)) #f)
           (coop-racer-remount self kind)))
        ((coop-flut-section?) (coop-racer-remount self #f)))
      (go target-stance))
  :post target-no-stick-post)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; player 2's view
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defmacro coop-goal-address? (ptr)
  "Is ptr an address inside the game's memory (so it can be read without crashing)?"
  `(let ((coop-addr (the-as uint ,ptr)))
     (and (>= coop-addr #x10000) (< coop-addr #x8000000))))

(defun coop-sprite-owner ((info sparticle-cpuinfo))
  "The player a 2d particle belongs to (0 or 1), or -1: the player bit of its launcher's process, or
   the pin of that process or its parent (a minigame host and its children). Read-only and careful:
   a particle can outlive its launcher's process, whose memory may hold something else by now, so
   every pointer is range-checked before it is followed and nothing is called on the process."
  (let ((key (-> info key)))
    (when (and (-> info valid) (coop-goal-address? key))
      (let ((proc (-> key proc)))
        (when (coop-goal-address? proc)
          (let ((mask (-> proc mask)))
            (cond
              ((logtest? mask (process-mask player2)) (return 1))
              ((logtest? mask (process-mask target sidekick camera coop-p1)) (return 0))))
          (when (> (-> *coop-pins* count) 0)
            (let ((parent (-> proc parent))
                  (parent-node (the-as process-tree #f)))
              (if (coop-goal-address? parent) (set! parent-node (-> parent 0)))
              (dotimes (i 4)
                (let ((p (handle->process (-> *coop-pins* proc i))))
                  (if (and p (or (= p proc) (= p parent-node))) (return (-> *coop-pins* player i))))))))))
    -1))

(defun coop-add-hud-sprite-data ((dma-buff dma-buffer) (data pointer) (start int) (count int))
  "*coop-hud-sprite-hook*: screen sprites (HUD particles: health, the periscope's binocular mask, the
   frog game's crosshair) are simulated once and normally referenced by both views. On split frames
   each view gets a copy instead, with the other player's sprites shrunk to nothing (coop-sprite-owner;
   sprites of world processes stay in both views). Sprite k is particle k of the 2d particle system."
  (when (coop-split-frame?)
    (let ((qwc (* 3 count))
          (pkt (the-as dma-packet (-> dma-buff base))))
      (set! (-> pkt dma) (new 'static 'dma-tag :id (dma-tag-id cnt) :qwc qwc))
      (set! (-> pkt vif0) (new 'static 'vif-tag :cmd (vif-cmd nop)))
      (set! (-> pkt vif1) (new 'static 'vif-tag :cmd (vif-cmd unpack-v4-32) :num qwc :imm (new 'static 'vif-unpack-imm :flg 1 :addr 1)))
      (&+! (-> dma-buff base) 16)
      (let ((copy (the-as (inline-array sprite-vec-data-2d) (-> dma-buff base))))
        (quad-copy! (-> dma-buff base) data qwc)
        (dotimes (i count)
          (let ((owner (coop-sprite-owner (-> *sp-particle-system-2d* cpuinfo-table (+ start i)))))
            (when (and (>= owner 0) (!= owner *coop-view*))
              (set! (-> copy i sx) 0.0)
              (set! (-> copy i sy) 0.0)))))
      (&+! (-> dma-buff base) (* qwc 16))
      #t)))

(defun coop-draw-view-only ()
  "The view dependent part of real-main-draw-hook, for player 2's view.
   Nothing here may advance the simulation: touching events, actors-update, time of day, ocean
   waves, eye blinks and the fake shadow buffer swap only happen in player 1's pass."
  (generic-init-buffers)
  ;; texture uploads. These only upload what the previous view replaced, and must stay in the
  ;; order the renderer replays them in.
  (when (logtest? *texture-enable-user* 1)
    (dotimes (i (-> *level* length))
      (let ((lev (-> *level* level i))) (if (= (-> lev status) 'active) (add-tex-to-dma! *texture-pool* lev 0)))))
  (when (logtest? *texture-enable-user* 2)
    (dotimes (i (-> *level* length))
      (let ((lev (-> *level* level i))) (if (= (-> lev status) 'active) (add-tex-to-dma! *texture-pool* lev 1)))))
  (when (logtest? *texture-enable-user* 4)
    (dotimes (i (-> *level* length))
      (let ((lev (-> *level* level i))) (if (= (-> lev status) 'active) (add-tex-to-dma! *texture-pool* lev 2)))))
  (when (logtest? *texture-enable-user* 8)
    (let ((uploaded-common #f))
      (dotimes (i (-> *level* length))
        (let ((lev (-> *level* level i)))
          (when (= (-> lev status) 'active)
            (add-tex-to-dma! *texture-pool* lev 3)
            (when (not uploaded-common)
              (upload-one-common! *texture-pool* (-> *level* level0))
              (set! uploaded-common #t)))))
      (if (not uploaded-common) (upload-one-common! *texture-pool* (-> *level* level0)))))
  (when (logtest? *texture-enable-user* 16)
    (dotimes (i (-> *level* length))
      (let ((lev (-> *level* level i))) (if (= (-> lev status) 'active) (add-tex-to-dma! *texture-pool* lev 4)))))
  ;; sky. The sky textures were generated in player 1's pass, which the renderer runs first.
  (when (zero? (logand *vu1-enable-user* (vu1-renderer-mask sky)))
    (with-dma-buffer-add-bucket ((dma-buf (-> (current-frame) global-buf)) (bucket-id sky-draw))
      (dma-buffer-add-gs-set dma-buf
                             (zbuf-1 (new 'static 'gs-zbuf :zbp #x1c0 :psm (gs-psm ct24)))
                             (test-1 (new 'static 'gs-test :ate #x1 :atst (gs-atest always) :zte #x1 :ztst (gs-ztest always)))
                             (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1)))
      (screen-gradient dma-buf
                       (-> *display* bg-clear-color 0)
                       (-> *display* bg-clear-color 1)
                       (-> *display* bg-clear-color 2)
                       (-> *display* bg-clear-color 3))))
  (when (logtest? *vu1-enable-user* (vu1-renderer-mask sky))
    (cond
      ((and (-> *time-of-day-context* sky) *sky-drawn*) (render-sky-tng *time-of-day-context*))
      (else
       (with-dma-buffer-add-bucket ((dma-buf (-> (current-frame) global-buf)) (bucket-id sky-draw))
         (dma-buffer-add-gs-set dma-buf
                                (zbuf-1 (new 'static 'gs-zbuf :zbp #x1c0 :psm (gs-psm ct24)))
                                (test-1 (new 'static 'gs-test :ate #x1 :atst (gs-atest always) :zte #x1 :ztst (gs-ztest always)))
                                (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1)))
         (screen-gradient dma-buf
                          (-> *time-of-day-context* erase-color)
                          (-> *time-of-day-context* erase-color)
                          (-> *time-of-day-context* erase-color)
                          (-> *time-of-day-context* erase-color))))))
  ;; ocean, using the waves draw-ocean generated in player 1's pass
  (draw-ocean-view)
  ;; merc and shadows start over for each view
  (set! (-> *merc-global-array* count) (the-as uint 0))
  (set! *merc-globals* (the-as merc-globals (-> *merc-global-array* globals)))
  (set! (-> *shadow-queue* cur-run) (the-as uint 0))
  ;; background
  (init-background)
  (execute-connections *background-draw-engine* (-> *display* frames (-> *display* on-screen) frame))
  (finish-background)
  ;; foreground
  (foreground-engine-execute (-> *level* level-default foreground-draw-engine 0)
                             (-> *display* frames (-> *display* on-screen) frame)
                             2
                             0)
  (foreground-engine-execute (-> *level* level-default foreground-draw-engine 1)
                             (-> *display* frames (-> *display* on-screen) frame)
                             2
                             1)
  (let ((global-buf (-> *display* frames (-> *display* on-screen) frame global-buf)))
    ;; skinning bakes in this view's camera, so it must run before the camera changes again
    (bones-mtx-calc-execute)
    (generic-merc-execute-all global-buf)
    (shadow-execute-all global-buf *shadow-queue*))
  ;; particles and other sprites (simulated once by process-particles)
  (when (logtest? (vu1-renderer-mask sprite) *vu1-enable-user*)
    (sprite-draw *display*))
  (none))

(defun coop-draw-player2-view ()
  "Render player 2's view into the second group of buckets. Called by display-loop after player 1's
   view (*draw-hook*) on split-screen frames."
  (let ((frame (-> *display* frames (-> *display* on-screen) frame))
        (prev-player (coop-switch-context 1)))
    (set! *coop-view* 1)
    (+! (-> *coop* render-passes) 1)
    ;; update-time-of-day computed this frame's fog into player 1's camera
    (let ((p1-cam (-> *coop-context-p1* math-camera)))
      (set! (-> *math-camera* fog-start) (-> p1-cam fog-start))
      (set! (-> *math-camera* fog-end) (-> p1-cam fog-end))
      (set! (-> *math-camera* fog-max) (-> p1-cam fog-max))
      (set! (-> *math-camera* fog-min) (-> p1-cam fog-min)))
    ;; player 2's camera rig -> player 2's math camera, frustum, tie/shrub constants
    (with-coop-view-camera
      (update-camera))
    (coop-draw-view-only)
    (if (not *progress-process*) (depth-cue *display*))
    ;; the camera dependent setup of this group's tie and merc buckets, with this view's camera.
    ;; display-frame-finish does it for player 1's group.
    (tie-init-buffers (-> frame calc-buf))
    (merc-vu1-init-buffers)
    ;; draw-ocean leaves this to the last view of the frame
    (when (not (paused?))
      (set! *ocean-off* #f)
      (set! *ocean-mid-off* #f)
      (set! *ocean-near-off* #f))
    (set! *coop-view* 0)
    ;; back to player 1's globals and player 1's group of buckets
    (coop-switch-context prev-player))
  (set! (-> *display* frames (-> *display* on-screen) frame bucket-group) (-> *coop-frame* groups 0))
  (none))

(defun coop-at-title? ()
  "Is player 1 on the title screen (the game's end leads there with co-op still on)? No player 2 there."
  (let ((p1 (coop-player-target 0)))
    (and p1
         (-> p1 state)
         (let ((name (-> p1 state name)))
           (or (= name 'target-title) (= name 'target-title-play) (= name 'target-title-wait))))))

(defun coop-want-split? ()
  "Should the next frame show two views? Only during normal gameplay with both players around.
   Menus and cutscenes use one full-screen view of player 1."
  (and (coop-active?)
       (coop-player-target 1)
       (handle->process (-> *coop-context-p2* combiner-handle))
       (= *master-mode* 'game)
       (not (movie?))
       (not (coop-at-title?))
       ;; npc conversations and other cutscene cameras, except a minigame's screen while the other
       ;; player is free (it shows in the minigame player's view only)
       (or (zero? *camera-look-through-other*) (>= (coop-look-through-player) 0))
       (not *progress-process*)))

(defun coop-neutralize-pad ((pad cpad-info))
  "This tick, the player using pad reads no input."
  (set! (-> pad button0-abs 0) (pad-buttons))
  (set! (-> pad button0-rel 0) (pad-buttons))
  (set! (-> pad leftx) (the-as uint 128))
  (set! (-> pad lefty) (the-as uint 128))
  (set! (-> pad rightx) (the-as uint 128))
  (set! (-> pad righty) (the-as uint 128))
  (set! (-> pad stick0-speed) 0.0)
  (none))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; session manager
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(deftype coop-timers (structure)
  ((p2-missing time-frame)))

;; a time-frame is 64 bits, a symbol's value only 32, so the timer lives in a structure
(define *coop-timers* (new 'static 'coop-timers))

;; bit per player hidden by coop-update for the length of a cinematic about the other player
(define *coop-movie-hidden* 0)

;; bit per player frozen by coop-update because a cinematic froze the other player
(define *coop-movie-slept* 0)

(define *coop-ear* (new 'global 'vector))

(defun coop-player-in-play? ((tgt target))
  (and tgt
       (not (logtest? (-> tgt state-flags) (state-flags dying)))
       (-> tgt state)
       (!= (-> tgt state name) 'target-death)
       (!= (-> tgt state name) 'target-coop-respawn)))

(defun coop-clone-anim-state? ((name symbol))
  "Is name a state a player is in while a cinematic animates them: on foot, on the zoomer or on the
   flut flut."
  (or (= name 'target-clone-anim) (= name 'target-racing-clone-anim) (= name 'target-flut-clone-anim)))

(defun coop-held? ((tgt target))
  "Is tgt held by a cutscene, talk or ride: grabbed, or about to be (a grab takes effect when tgt
   next runs)?"
  (and tgt
       (or (logtest? (-> tgt state-flags) (state-flags grabbed))
           (and (-> tgt next-state)
                (or (coop-grab-state? (-> tgt next-state name)) (coop-clone-anim-state? (-> tgt next-state name)))))))

(defun coop-solo-cam-player ((cam process))
  "An othercam pinned alone to a player while the other player is in play (the Dark Eco Plant's view
   of eating that player): that player, else -1. Such a cinematic shows only in that player's view
   and doesn't stop the world (no movie setting): the other player plays on."
  (when (and cam (coop-active?) (> (-> *coop-pins* count) 0))
    (dotimes (i 4)
      (when (and (= (handle->process (-> *coop-pins* proc i)) cam) (-> *coop-pins* alone i))
        (let ((player (-> *coop-pins* player i)))
          (if (coop-player-in-play? (coop-player-target (- 1 player))) (return player))))))
  -1)

(defun coop-look-through-player ()
  "During a look-through camera (*camera-look-through-other*, e.g. the fisherman's play-again
   screen): the player it belongs to when it is a minigame's and the other player is free, or a
   cinematic of one player (coop-solo-cam-player), else -1 (then it is a cutscene for both and fills
   the screen)."
  (if (zero? *camera-look-through-other*) (return -1))
  (let ((solo (coop-solo-cam-player (handle->process (-> *game-info* other-camera-handle)))))
    (if (>= solo 0) (return solo)))
  (dotimes (i 2)
    (if (and (coop-player-in-minigame? (coop-player-target i)) (not (coop-held? (coop-player-target (- 1 i))))) (return i)))
  -1)

(defun coop-look-through-here? ()
  "update-camera: does the look-through camera apply to the view being updated? Always without
   co-op; with a minigame's look-through only in that player's view."
  (or (not (coop-active?))
      (let ((owner (coop-look-through-player))) (or (< owner 0) (= owner *coop-player*)))))

(defun coop-grab-watch ()
  "Once per tick: when one player of the recorded grab pair is no longer held, the other one is
   released too and the pair is forgotten. Catches releases that don't go through
   coop-grab-other-player (a grabber ending a zoomer or flut flut grab with 'end-mode, a player
   leaving a cutscene on their own, a grabber that went away), so a partner is never left held and
   a stale pair can't swallow the next grab's release."
  (let ((main (the-as target (handle->process (-> *coop-grab* main))))
        (partner (the-as target (handle->process (-> *coop-grab* partner)))))
    (when (and (or main partner) (not (and (coop-held? main) (coop-held? partner))))
      (set! (-> *coop-grab* main) (the-as handle #f))
      (set! (-> *coop-grab* partner) (the-as handle #f))
      (let ((still-held (if (coop-held? main) main partner)))
        ;; only a plain grab is ours to end; a cutscene animating the player ends it itself
        (when (and still-held (coop-grab-state? (the-as symbol (send-event still-held 'query 'mode))))
          (format 0 "[coop] the other player was released, releasing player ~D too~%" (+ 1 (coop-process-player still-held)))
          (send-event still-held 'end-mode)))))
  (none))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; the players touching each other: collision, pushing, friendly fire
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; a player walking into the other one pushes them along at up to this speed
(defconstant COOP_PUSH_SPEED (meters 4))

;; is collision between the two players on? It only turns on while their bodies don't overlap (after
;; a respawn or a cutscene they can stand in each other), then stays on while both may collide.
(define *coop-contact?* #f)

;; after a friendly-fire hit, collision between the players stays off until this time: an attacking
;; body has the higher offense and moves through what it hits (as with enemies), and would then
;; stand in the way of the knockback
(define *coop-contact-off-until* (the-as time-frame 0))

(defun coop-player-collides? ((tgt target))
  "May tgt bump into, stand on and hit the other player right now? Not while held (cutscene, talk,
   ride), on a zoomer, playing a minigame, spawning, warping, waiting to respawn, hidden or frozen,
   or while the game has switched tgt's collision off."
  (and (coop-player-in-play? tgt)
       (not (coop-held? tgt))
       (not (coop-player-racing? tgt))
       (not (coop-player-in-minigame? tgt))
       ;; hidden for a cinematic about the other player (not the draw flag: it blinks after a hit)
       (zero? (logand *coop-movie-hidden* (ash 1 (coop-process-player tgt))))
       (not (logtest? (-> tgt mask) (process-mask sleep)))
       (logtest? (-> tgt control root-prim collide-with) (collide-kind background))
       (case (-> tgt state name)
         (('target-coop-spawn 'target-warp-out 'target-warp-in) #f)
         (else #t))))

(defun coop-set-player-contact ((tgt target) (on symbol))
  "Make tgt solid to the other player, or not: the target kind in the collide-with of tgt's root and
   body spheres. The overlaps found through it also bring the other player's attacks to tgt.
   Collision the game switched off (death, cutscenes) stays off."
  (let ((root (-> tgt control root-prim)))
    (cond
      ((and on (logtest? (-> root collide-with) (collide-kind background)))
       (logior! (-> root collide-with) (collide-kind target))
       (dotimes (i 3)
         (logior! (-> tgt control unknown-sphere-array00 i collide-with) (collide-kind target))))
      (else
       (logclear! (-> root collide-with) (collide-kind target))
       (dotimes (i 3)
         (logclear! (-> tgt control unknown-sphere-array00 i collide-with) (collide-kind target))))))
  (none))

(defun coop-players-overlap? ((a target) (b target) (xz float) (y float))
  "Are the two players closer than xz horizontally and y vertically? Their bodies (0.7 m spheres up
   to 2.8 m high) overlap within 1.4 m and 2.8 m."
  (let ((d (vector-! (new 'stack-no-clear 'vector) (-> b control trans) (-> a control trans))))
    (and (< (fabs (-> d y)) y) (< (vector-xz-length d) xz))))

(defun coop-push-player ((pusher target) (pushed target))
  "pusher walks into pushed (same height, touching, facing them): pushed is moved along at up to
   COOP_PUSH_SPEED. The speed goes into their own movement, so walls and edges work as usual."
  (let ((d (vector-! (new 'stack-no-clear 'vector) (-> pushed control trans) (-> pusher control trans)))
        (facing (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> pusher control quat-for-control))))
    (when (and (or (= (-> pusher state name) 'target-walk) (= (-> pusher state name) 'target-flut-walk))
               (< (fabs (-> d y)) (meters 1))
               (< (vector-xz-length d) (meters 1.6))
               (logtest? (-> pushed control status) (cshape-moving-flags onsurf))
               (not (logtest? (-> pushed state-flags) (state-flags dangerous being-attacked))))
      (set! (-> d y) 0.0)
      (vector-normalize! d 1.0)
      (set! (-> facing y) 0.0)
      (vector-normalize! facing 1.0)
      (when (< 0.6 (vector-dot d facing))
        (let ((speed (* (-> pusher control pad-magnitude) COOP_PUSH_SPEED))
              (along (vector-dot (-> pushed control transv) d)))
          (if (< along speed) (vector+float*! (-> pushed control transv) (-> pushed control transv) d (- speed along)))))))
  (none))

(defun coop-contact-update ()
  "Once per tick: collision between the players on or off, and pushing."
  (let* ((p1 (coop-player-target 0))
         (p2 (coop-player-target 1))
         (both (and p1 p2 (coop-player-collides? p1) (coop-player-collides? p2) (< *coop-contact-off-until* (current-time)))))
    ;; deep inside each other (a script or teleport put one player there): off until they're apart
    (set! *coop-contact?* (if (and both
                                   (not (coop-players-overlap? p1 p2 (meters 1) (meters 2.4)))
                                   (or *coop-contact?* (not (coop-players-overlap? p1 p2 (meters 1.4) (meters 2.8)))))
                            #t
                            #f))
    (if p1 (coop-set-player-contact p1 *coop-contact?*))
    (if p2 (coop-set-player-contact p2 *coop-contact?*))
    (when *coop-contact?*
      (coop-push-player p1 p2)
      (coop-push-player p2 p1)))
  (none))

(defun coop-continue ((cp continue-point))
  "A script sends the player to a checkpoint ('continue, e.g. after Klaww's intro). With co-op only
   player 1 runs target-continue (it sets the continue point, camera and load state); player 2 is
   taken out and comes back next to player 1 once player 1 stands there."
  (cond
    ((coop-active?)
     (send-event (coop-player-target 0) 'continue cp)
     (coop-despawn-player2))
    (else (send-event *target* 'continue cp)))
  (none))

(defun coop-lowest-health ()
  "Health of the most hurt player in play, for help a boss gives a struggling player (Klaww's green
   eco boulders). *target*'s health without co-op."
  (let ((health (-> *target* fact health)))
    (when (coop-active?)
      (dotimes (i 2)
        (let ((tgt (coop-player-target i)))
          (if (and (coop-player-in-play? tgt) (< (-> tgt fact health) health)) (set! health (-> tgt fact health))))))
    health))

(defun coop-boss-hits ((hits int))
  "Hits a boss (phase) needs: with co-op and the option \"Co-op: tougher bosses\" half as many
   again (rounded up), else unchanged."
  (if (and (coop-active?) (-> *coop* tougher-bosses?)) (/ (+ (* hits 3) 1) 2) hits))

(defun coop-boss-phase-health ((health float) (base int))
  "A boss's health on its original scale of base hits, for what decides its phases (how many minions,
   how many attacks in a row). With the option \"Co-op: tougher bosses\" the health starts at
   coop-boss-hits base: the phases are spread over the extra hits. Unchanged otherwise."
  (let ((hits (coop-boss-hits base)))
    (if (= hits base) health (the float (the int (+ 0.5 (/ (* health (the float base)) (the float hits))))))))

(defun coop-send-to-players ((msg symbol) (arg object))
  "Send msg to *target* and, with co-op, to the other player too (a boss resets both players' eco)."
  (send-event *target* msg arg)
  (when (coop-active?)
    (let ((other (coop-player-target (- 1 *coop-player*))))
      (if other (send-event other msg arg))))
  (none))

(defun coop-boss-eats ((boss process) (victim process))
  "A boss starts eating a player it caught (Dark Eco Plant). While the other player is in play the
   boss runs for the victim until it calls coop-unpin: its scene's camera goes to the victim's view
   and the end of the scene releases the victim, not the nearest player. The boss's minions keep
   going after the other player."
  (if (and (coop-active?) (= (-> victim type) target) (coop-other-player-alive? (the-as target victim)))
    (coop-pin-alone boss (process->handle victim)))
  (none))

(defun coop-pin-alone-like ((proc process) (like process))
  "Pin proc alone to the player like is pinned to, if like is pinned (a boss's eat scene camera
   follows the boss, coop-boss-eats)."
  (let ((player (coop-pinned-player like)))
    (if (>= player 0) (coop-pin-alone proc (process->handle (coop-player-target player)))))
  (none))

(defun coop-lowest-player-y ()
  "Height of the lowest player in play (a boss's bomb waits until every player escaped upward).
   *target*'s height without co-op."
  (let ((y (-> (target-pos 0) y)))
    (when (coop-active?)
      (dotimes (i 2)
        (let ((tgt (coop-player-target i)))
          (if (and (coop-player-in-play? tgt) (< (-> tgt control trans y) y)) (set! y (-> tgt control trans y))))))
    y))

(defun coop-in-blast? ((tgt target) (y float) (touched symbol))
  "Does a blast that reaches up to height y get tgt? touched: the player who touched the bomb
   (*target* in its context) is in it anyway."
  (or (< (-> tgt control trans y) y) (and touched (= tgt *target*))))

(defun coop-blast-survivor? ((y float) (touched symbol))
  "Co-op, a bomb goes off (Gol and Maia's dark eco bombs): is a player in play out of its reach?
   Then the others are knocked out by it (coop-blast-players) and the fight goes on; if none is,
   the original death of the whole party runs. Always #f without co-op."
  (let ((found #f))
    (when (coop-active?)
      (dotimes (i 2)
        (let ((tgt (coop-player-target i)))
          (if (and (coop-player-in-play? tgt) (not (coop-in-blast? tgt y touched))) (set! found #t)))))
    found))

(defun coop-blast-players ((y float) (touched symbol))
  "Knock out every player in play a blast up to height y reaches (coop-in-blast?)."
  (dotimes (i 2)
    (let ((tgt (coop-player-target i)))
      (when (and (coop-player-in-play? tgt) (coop-in-blast? tgt y touched))
        (format 0 "[coop] the blast gets player ~D~%" (+ i 1))
        (send-event tgt 'attack-invinc #f (static-attack-info ((mode 'instant-death)))))))
  (none))

(defun coop-put-other-player-near ((tgt target) (pos vector))
  "A script moves tgt far away (the final boss's ending puts the player at the big door): the other
   player is put 1.5 m beside pos, their camera jumps along."
  (when (coop-active?)
    (let ((other (coop-other-player-target tgt)))
      (when (and other (not (logtest? (-> other state-flags) (state-flags dying))))
        (let ((dest (new 'stack-no-clear 'vector)))
          (set! (-> dest quad) (-> pos quad))
          (+! (-> dest x) (meters 1.5))
          (set! (-> other control transv quad) (the-as uint128 0))
          (move-to-point! (-> other control) dest)
          (set! (-> other control camera-pos quad) (-> dest quad))
          (set! (-> other control last-known-safe-ground quad) (-> dest quad))
          (set! (-> other control highest-jump-mark quad) (-> dest quad))
          (let ((cam (handle->process (-> (coop-context (coop-process-player other)) camera-handle))))
            (if (and cam (!= (coop-process-player other) *coop-player*)) (send-event cam 'teleport)))
          (if (= (coop-process-player other) *coop-player*) (send-event *camera* 'teleport))
          (format 0 "[coop] player ~D is put next to player ~D~%" (+ 1 (coop-process-player other)) (+ 1 (coop-process-player tgt)))))))
  (none))

(defun coop-send-to-other-camera ((proc process) (msg symbol) (arg object))
  "Send msg to the camera of the player who doesn't own proc (with co-op)."
  (when (coop-active?)
    (let ((cam (handle->process (-> (coop-context (- 1 (coop-process-player proc))) camera-handle))))
      (if cam (send-event cam msg arg))))
  (none))

(defun coop-send-to-cameras ((msg symbol) (arg object))
  "Send msg to the camera of the player the code runs for and, with co-op, to the other player's
   camera too (a boss's point of interest belongs in both views)."
  (send-event *camera* msg arg)
  (when (coop-active?)
    (let ((cam (handle->process (-> (coop-context (- 1 *coop-player*)) camera-handle))))
      (if cam (send-event cam msg arg))))
  (none))

(defun coop-player-attack ((victim process) (attacker process) (touch object) (mode symbol))
  "One player's attack (punch, spin, flop, red eco, the flut flut's, a long fall onto their head)
   touched the other player. With friendly fire on, the victim is hit like by an enemy: knocked back
   away from the attacker, one point of health (a player killed this way respawns next to the other
   one as usual). The hit has no attack id, so enemies' de-duplication of player attacks isn't
   involved. Returns 'die when the hit landed (as an enemy that was knocked out: a punch stops its
   lunge there instead of running through the other player), else #f."
  (let ((v (the-as target victim))
        (a (the-as target attacker)))
    (when (and (-> *coop* friendly-fire?) *coop-contact?* (coop-player-collides? v) (coop-player-collides? a))
      (let ((info (new 'stack 'attack-info))
            (dir (vector-! (new 'stack-no-clear 'vector) (-> v control trans) (-> a control trans))))
        (if (< (vector-xz-length dir) (meters 0.1)) (vector-z-quaternion! dir (-> a control quat-for-control)))
        (vector-xz-normalize! dir (meters 2))
        (set! (-> dir y) (meters 1.5))
        (set! (-> info vector quad) (-> dir quad))
        (set! (-> info mode) 'generic)
        (set! (-> info shove-back) (meters 2))
        (set! (-> info shove-up) (meters 1.5))
        (set! (-> info attacker) (process->handle a))
        (set! (-> info mask) (attack-mask vector mode shove-back shove-up attacker))
        (when (send-event v 'attack touch info)
          (set! *coop-contact-off-until* (+ (current-time) (seconds 0.6)))
          (format 0 "[coop] player ~D's ~A hits player ~D~%" (+ 1 (coop-process-player a)) mode (+ 1 (coop-process-player v)))
          'die)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; level streaming for both players (#69)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Jak 1 keeps two levels. Load boundaries (load-boundary-data.gc) switch them as the camera or the
;; player crosses: (load a b), (display a #t/#f), (vis a), (checkpt name). With co-op both players'
;; cameras and positions cross them, and a crossing may only load a pair that keeps the level the
;; other player is in. A player heading for a third level is held back: put next to the other player.
;; Vis and checkpoints follow player 1 (as the continue point, music and the listener do).

;; player 2's load boundary points, as *load-boundary-target*: 0 camera, 1 player, 2 and 3 the same
;; one frame earlier
(define *coop-p2-boundary* (the-as (inline-array lbvtx) (malloc 'global 64)))

;; player 1's points while player 2's crossings are checked
(define *coop-p1-boundary-save* (the-as (inline-array lbvtx) (malloc 'global 64)))

(define *coop-p2-boundary-valid?* #f)

;; whose crossings check-boundary looks at (0 player 1, 1 player 2)
(define *coop-boundary-player* 0)

;; a move longer than this in one frame is a teleport (respawn, warp, being held back): no crossing
(defconstant COOP_BOUNDARY_JUMP (meters 10))

(defun coop-level-keeps-player? ((tgt target) (lev symbol) (on symbol))
  "Would tgt still have their level if the displayed levels became the ones named lev (and on, may be
   #f)? Every displayed level whose boxes contain tgt must stay (level boxes overlap near borders, so
   a player can be inside two); inside none, the nearest level must stay."
  (let ((inside-any #f))
    (dotimes (i (-> *level* length))
      (let ((l (-> *level* level i)))
        (when (and (= (-> l status) 'active) (point-in-boxes? l (-> tgt control trans)))
          (set! inside-any #t)
          (if (not (or (= (-> l name) lev) (= (-> l name) on))) (return #f)))))
    (or inside-any
        (let ((near (coop-level-containing *level* (-> tgt control trans) (the-as level #f))))
          (or (not near) (= (-> near name) lev) (= (-> near name) on))))))

(defun coop-boundary-skip-jumps ((points object))
  "A teleport since the last frame isn't a crossing: the old points (as *load-boundary-target*) become
   the new ones."
  (let ((pts (the-as (inline-array lbvtx) points)))
  (if (< COOP_BOUNDARY_JUMP (vector-vector-distance (-> pts 0 v) (-> pts 2 v))) (set! (-> pts 2 quad) (-> pts 0 quad)))
    (if (< COOP_BOUNDARY_JUMP (vector-vector-distance (-> pts 1 v) (-> pts 3 v))) (set! (-> pts 3 quad) (-> pts 1 quad))))
  (none))

(define *coop-hold-back-pending* 0)

(defun coop-hold-back ((idx int))
  "Player idx heads for a third level: they are put next to the other player instead. If that can't
   happen now (the other player is out of play, or idx is held by a cutscene), it happens as soon as
   it can (coop-hold-back-update)."
  (let ((me (coop-player-target idx))
        (other (coop-player-target (- 1 idx))))
    (cond
      ((and me other (coop-player-in-play? other) (not (coop-held? me)))
       (logclear! *coop-hold-back-pending* (ash 1 idx))
       (format 0 "[coop] player ~D heads for a third level, putting them next to player ~D~%" (+ idx 1) (- 2 idx))
       (let ((pos (coop-safe-position-near other (new 'stack-no-clear 'vector))))
         (set! (-> me control transv quad) (the-as uint128 0))
         (move-to-point! (-> me control) pos)
         (set! (-> me control highest-jump-mark quad) (-> pos quad))
         (set! (-> me control last-known-safe-ground quad) (-> pos quad))
         (set! (-> me control camera-pos quad) (-> pos quad))
         (let ((prev (coop-switch-context idx)))
           (send-event *camera* 'teleport)
           (coop-switch-context prev))))
      (else (logior! *coop-hold-back-pending* (ash 1 idx)))))
  (none))

(defun coop-hold-back-update ()
  "Once per tick: hold-backs that had to wait. A player who is out of play meanwhile (knocked out,
   respawning) comes back next to the other one anyway."
  (dotimes (i 2)
    (when (logtest? *coop-hold-back-pending* (ash 1 i))
      (if (coop-player-in-play? (coop-player-target i))
        (coop-hold-back i)
        (logclear! *coop-hold-back-pending* (ash 1 i)))))
  (none))

(defun coop-boundary-command-ok? ((crossing object))
  "check-boundary hook: may this crossing's command run? Always without co-op. A load that would drop
   the other player's level holds the crossing player back instead; turning that level's display off
   is ignored; vis and checkpoints follow player 1."
  (if (not (coop-active?)) (return #t))
  (let* ((cmd (the-as load-boundary-crossing-command crossing))
         (me *coop-boundary-player*)
         (other (coop-player-target (- 1 me)))
         (other? (and other (coop-player-in-play? other))))
    (case (-> cmd cmd)
      (((load-boundary-cmd load))
       (cond
         ((or (not other?) (coop-level-keeps-player? other (the-as symbol (-> cmd lev0)) (the-as symbol (-> cmd lev1)))) #t)
         (else (coop-hold-back me) #f)))
      ;; turning a level's display off: not while the other player is in it
      (((load-boundary-cmd display))
       (or (if (-> cmd lev1) #t #f)
           (not other?)
           (let ((keep #t))
             (dotimes (i (-> *level* length))
               (let ((l (-> *level* level i)))
                 (if (and (= (-> l name) (the-as symbol (-> cmd lev0))) (= (-> l status) 'active) (point-in-boxes? l (-> other control trans)))
                   (set! keep #f))))
             keep)))
      (((load-boundary-cmd vis) (load-boundary-cmd force-vis) (load-boundary-cmd checkpt)) (zero? me))
      (else #t))))

(defun coop-check-boundaries-p2 ()
  "render-boundaries hook, after player 1's crossings: player 2's camera and position cross the load
   boundaries too."
  (let ((p2 (coop-player-target 1))
        (comb (the-as camera-combiner (handle->process (-> *coop-context-p2* combiner-handle)))))
    (cond
      ((not (and p2 comb (coop-player-in-play? p2))) (set! *coop-p2-boundary-valid?* #f))
      (else
       (set! (-> *coop-p2-boundary* 2 quad) (-> *coop-p2-boundary* 0 quad))
       (set! (-> *coop-p2-boundary* 3 quad) (-> *coop-p2-boundary* 1 quad))
       (set! (-> *coop-p2-boundary* 0 quad) (-> comb trans quad))
       (set! (-> *coop-p2-boundary* 1 quad) (-> p2 control trans quad))
       (when (not *coop-p2-boundary-valid?*)
         (set! (-> *coop-p2-boundary* 2 quad) (-> *coop-p2-boundary* 0 quad))
         (set! (-> *coop-p2-boundary* 3 quad) (-> *coop-p2-boundary* 1 quad))
         (set! *coop-p2-boundary-valid?* #t))
       (coop-boundary-skip-jumps *coop-p2-boundary*)
       ;; check-boundary reads *load-boundary-target*: lend it player 2's points
       (dotimes (i 4)
         (set! (-> *coop-p1-boundary-save* i quad) (-> *load-boundary-target* i quad))
         (set! (-> *load-boundary-target* i quad) (-> *coop-p2-boundary* i quad)))
       (set! *coop-boundary-player* 1)
       (let ((lb *load-boundary-list*))
         (while lb
           (if (nonzero? (-> lb tri-cnt)) (check-boundary lb))
           (set! lb (-> lb next))))
       (set! *coop-boundary-player* 0)
       (dotimes (i 4)
         (set! (-> *load-boundary-target* i quad) (-> *coop-p1-boundary-save* i quad))))))
  (none))

(defun coop-draw-player-labels ()
  "On split frames: a small P1 / P2 in a corner of each player's view, in the player's colour (the
   divider between the views has the same colours, see SplitscreenLayout.h)."
  (when (coop-split-frame?)
    (dotimes (i 2)
      (let ((prev (coop-switch-context i))
            ;; bottom right: the corner the game's HUD uses least (yellow eco timer, zoomer heat)
            (font (new 'stack
                       'font-context
                       *font-default-matrix*
                       450
                       190
                       0.0
                       (if (zero? i) (font-color cyan) (font-color orange))
                       (font-flags shadow kerning large))))
        (set-scale! font 0.75)
        (print-game-text (if (zero? i) "P1" "P2") font #f 128 22)
        (coop-switch-context prev))))
  (none))

(defun coop-update ()
  "Once per frame: split decision and listener. In game mode also player positions, player 2 respawn
   and the distance leash."
  (coop-draw-player-labels)
  (set! (-> *coop* split?) (if (coop-want-split?) #t #f))
  ;; one listener for the session: player 1 (level streaming and ambients follow player 1 too)
  (let ((p1 (coop-player-target 0)))
    (set! (-> *coop-ear* quad) (-> (if p1 (-> p1 control trans) (camera-pos)) quad))
    (set! *ear-trans-override* *coop-ear*))
  ;; during a cinematic that holds player 1 but not player 2 (some skip process-grab?), player 2 stands
  ;; still. Pad 0 is never touched: menus, the title screen and minigame prompts read it.
  (when (and (= *master-mode* 'game) (or (movie?) (nonzero? *camera-look-through-other*)))
    (let ((p1 (coop-player-target 0))
          (p2 (coop-player-target 1)))
      (if (and p1
               p2
               (logtest? (-> p1 state-flags) (state-flags grabbed))
               (not (logtest? (-> p2 state-flags) (state-flags grabbed))))
        (coop-neutralize-pad (-> p2 control cpad)))))
  ;; a cinematic about one player (power cell victory, talking to an npc) shows only that player:
  ;; the other one and their daxter are hidden until it ends, so they don't stand in the shot.
  (dotimes (i 2)
    (let ((me (coop-player-target i))
          (other (coop-player-target (- 1 i)))
          (bit (ash 1 i)))
      (cond
        ((and me
              other
              (movie?)
              (coop-player-in-play? me)
              (not (coop-player-in-minigame? me))
              (coop-clone-anim-state? (-> other state name))
              (not (coop-clone-anim-state? (-> me state name))))
         ;; hidden and frozen: they can't drive or walk away unseen (e.g. into lava on the zoomer)
         (when (zero? (logand *coop-movie-hidden* bit))
           (coop-set-hidden me #t)
           (logior! (-> me mask) (process-mask sleep))
           (logior! *coop-movie-hidden* bit)))
        ((nonzero? (logand *coop-movie-hidden* bit))
         (when me
           (coop-set-hidden me #f)
           (logclear! (-> me mask) (process-mask sleep)))
         (logclear! *coop-movie-hidden* bit)))))
  (pc-set-splitscreen-layout! (the-as int (-> *coop* layout)))
  ;; the rest is gameplay: nothing moves while paused or in a menu
  (if (!= *master-mode* 'game) (return #f))
  (+! (-> *coop* sim-ticks) 1)
  (coop-grab-watch)
  (coop-hold-back-update)
  (coop-contact-update)
  ;; some cinematics freeze the player with process-mask sleep instead of a grab (power cell plants,
  ;; the last race ring, lightning moles): freeze the other player for as long too
  (dotimes (i 2)
    (let ((me (coop-player-target i))
          (other (coop-player-target (- 1 i)))
          (bit (ash 1 i)))
      (cond
        ((and me
              other
              (or (movie?) (nonzero? *camera-look-through-other*))
              (logtest? (-> other mask) (process-mask sleep))
              (not (coop-player-in-minigame? me))
              (zero? (logand *coop-movie-slept* (ash 1 (- 1 i))))
              (zero? (logand *coop-movie-hidden* (ash 1 (- 1 i))))
              (not (logtest? (-> me mask) (process-mask sleep))))
         (logior! (-> me mask) (process-mask sleep))
         (logior! *coop-movie-slept* bit))
        ((and (nonzero? (logand *coop-movie-slept* bit))
              (not (and other (logtest? (-> other mask) (process-mask sleep)))))
         (if me (logclear! (-> me mask) (process-mask sleep)))
         (logclear! *coop-movie-slept* bit)))))
  (coop-racer-update)
  ;; actors near player 2 must exist and run even when player 1's camera is far away or can't see
  ;; them. Same as the "force actors" PC option, without touching the saved setting.
  ;; (pc-settings update may lower these again after the frame; actor birth and pause happen
  ;; during the next tick and draw, after this runs.)
  (set! (-> *ACTOR-bank* birth-dist) (meters 10000))
  (set! (-> *ACTOR-bank* pause-dist) (meters 10000))
  (set! (-> *ACTOR-bank* birth-max) 1000)
  (let ((p1 (coop-player-target 0))
        (p2 (coop-player-target 1)))
    ;; world processes follow the closest player that is in play (not dying or waiting to respawn)
    (set! (-> *coop-players* valid 0) (if (coop-player-in-play? p1) #t #f))
    (set! (-> *coop-players* valid 1) (if (coop-player-in-play? p2) #t #f))
    (if p1 (set! (-> *coop-players* pos 0 quad) (-> p1 control trans quad)))
    (if p2 (set! (-> *coop-players* pos 1 quad) (-> p2 control trans quad)))
    (cond
      ((coop-at-title?)
       ;; the title screen: nobody to play next to (the title menu stops co-op)
       (set! (-> *coop-timers* p2-missing) 0)
       (if p2 (coop-despawn-player2)))
      ((not p2)
       ;; player 2 is missing (not spawned yet, died, or killed by a player 1 restart).
       ;; respawn next to player 1 after a short delay, once player 1 is in control.
       (cond
         ((zero? (-> *coop-timers* p2-missing)) (set! (-> *coop-timers* p2-missing) (current-time)))
         ;; player 1 coming out of a warp gate: player 2 comes out right behind them
         ((or (coop-player-warping-in? p1)
              (and (coop-target-ready? p1) (time-elapsed? (-> *coop-timers* p2-missing) (-> *coop* respawn-delay))))
          (set! (-> *coop-timers* p2-missing) 0)
          (coop-despawn-player2) ;; clean up a camera rig left behind
          (coop-spawn-player2 (coop-safe-position-near p1 (new 'stack-no-clear 'vector))))))
      (else
       (set! (-> *coop-timers* p2-missing) 0)
       ;; distance leash, a safety net only: streaming follows both players and a player heading for
       ;; a third level is held back (coop-boundary-command-ok?).
       ;; no leash in a zoomer section: they race the level at their own pace, and a player who died
       ;; starts again from the checkpoint
       (when (and (-> *coop* leash?)
                  (not (coop-vehicle-section?))
                  (coop-player-in-play? p1)
                  (coop-player-in-play? p2)
                  (< (-> *coop* leash-distance) (vector-vector-distance (-> p1 control trans) (-> p2 control trans))))
         (cond
           ;; player 2 plays a minigame: it stays with them, player 1 is the one brought back
           ((coop-player-in-minigame? p2)
            (when (coop-target-ready? p1)
              (format 0 "[coop] player 1 is too far from player 2's minigame, bringing them back~%")
              (let ((pos (coop-safe-position-near p2 (new 'stack-no-clear 'vector))))
                (set! (-> p1 control transv quad) (the-as uint128 0))
                (move-to-point! (-> p1 control) pos)
                (set! (-> p1 control highest-jump-mark quad) (-> pos quad))
                (send-event *camera* 'teleport))))
           ((coop-target-ready? p1)
            (format 0 "[coop] player 2 is too far from player 1, bringing them back~%")
            (coop-despawn-player2)
            (coop-spawn-player2 (coop-safe-position-near p1 (new 'stack-no-clear 'vector))))))))))

(define-extern coop-print-info (function none))

(define-extern *coop-show-info* symbol)

(defun coop-manager-loop ()
  ;; runs while paused and in menus too: the split decision must see them (menus are full screen)
  (with-pp (logclear! (-> pp mask) (process-mask pause menu progress)))
  (loop
    (when (coop-active?)
      (coop-update)
      (if *coop-show-info* (coop-print-info)))
    (suspend))
  (none))

(define *coop-manager* (the-as (pointer process) #f))

;; *ACTOR-bank* values before co-op raised them, restored by coop-stop
(define *coop-saved-actor-bank* (new 'static 'actor-bank))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; start / stop
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun coop-set-save-folder ((name string))
  "Co-op saves go to their own folder (saves/coop), so single-player saves are never overwritten.
  A running auto-save is stopped first so it can't write into the other folder, and auto-save stays
  off until the player picks a slot in the save menu (the remembered slot belongs to the other folder)."
  (let ((save-proc (handle->process (-> *game-info* auto-save-proc))))
    (if save-proc (send-event save-proc 'die)))
  (pc-set-memcard-namespace! name)
  (set! (-> *game-info* auto-save-which) -1)
  (set! (-> *setting-control* default auto-save) #f)
  (none))

(defun coop-start ()
  "Start local co-op: install the player contexts, enable per-slot input, spawn player 2."
  (when (not (coop-active?))
    (coop-init-p2-context)
    (coop-link-tree-after *coop-p2-target-pool* *target-pool*)
    (coop-link-tree-after *coop-p2-camera-pool* *camera-pool*)
    (set! *coop-player* 0)
    (set! (-> *coop* sim-ticks) 0)
    (set! (-> *coop* render-passes) 0)
    (set! (-> *coop-timers* p2-missing) 0)
    (set! *coop-hold-back-pending* 0)
    (set! *coop-p2-boundary-valid?* #f)
    (set! *player-context-for-process* coop-context-for-process)
    (set! *player-context-for-event* coop-context-for-event)
    (set! *player-context-restore* coop-context-restore)
    (set! *coop-hud-sprite-hook* coop-add-hud-sprite-data)
    (set! (-> *coop* active?) #t)
    (set! (-> *coop* enabled?) #t)
    ;; player 2's pad buzzes like player 1's
    (set! (-> *cpad-list* cpads (-> *coop* p2-pad) buzz) (-> *cpad-list* cpads 0 buzz))
    (pc-coop-set-input-enabled! #t)
    (coop-set-save-folder "coop")
    (set! *sparticle-ignore-frustum?* #t)
    (set! (-> *coop-saved-actor-bank* birth-dist) (-> *ACTOR-bank* birth-dist))
    (set! (-> *coop-saved-actor-bank* pause-dist) (-> *ACTOR-bank* pause-dist))
    (set! (-> *coop-saved-actor-bank* birth-max) (-> *ACTOR-bank* birth-max))
    (when (not *coop-manager*)
      (set! *coop-manager* (process-spawn-function process coop-manager-loop :name 'coop-manager :to *default-pool*)))
    (format 0 "[coop] local co-op started~%"))
  (coop-active?))

(defun coop-stop ()
  "Stop local co-op and go back to the single player game."
  (when (coop-active?)
    (coop-switch-context 0)
    (coop-despawn-player2)
    (set! *coop-contact?* #f)
    (if (coop-player-target 0) (coop-set-player-contact (coop-player-target 0) #f))
    ;; stopped during a cinematic about player 2: show player 1 again
    (when (logtest? *coop-movie-hidden* 1)
      (let ((p1 (coop-player-target 0)))
        (when p1
          (coop-set-hidden p1 #f)
          (logclear! (-> p1 mask) (process-mask sleep)))))
    (set! *coop-movie-hidden* 0)
    (dotimes (i 2)
      (let ((tgt (coop-player-target i)))
        (if (and tgt (logtest? *coop-movie-slept* (ash 1 i))) (logclear! (-> tgt mask) (process-mask sleep)))))
    (set! *coop-movie-slept* 0)
    (set! *player-context-for-process* #f)
    (set! *player-context-for-event* #f)
    (set! *player-context-restore* #f)
    (set! *coop-hud-sprite-hook* #f)
    (set! (-> *coop* active?) #f)
    (set! (-> *coop* enabled?) #f)
    (set! (-> *coop* split?) #f)
    (set! *ear-trans-override* #f)
    (pc-coop-set-input-enabled! #f)
    (coop-set-save-folder "")
    (set! *sparticle-ignore-frustum?* #f)
    ;; back to the single player actor distances (pc-settings re-applies "force actors" if it's on)
    (set! (-> *ACTOR-bank* birth-dist) (-> *coop-saved-actor-bank* birth-dist))
    (set! (-> *ACTOR-bank* pause-dist) (-> *coop-saved-actor-bank* pause-dist))
    (set! (-> *ACTOR-bank* birth-max) (-> *coop-saved-actor-bank* birth-max))
    (when *coop-manager*
      (deactivate (-> *coop-manager* 0))
      (set! *coop-manager* #f))
    (format 0 "[coop] local co-op stopped~%"))
  (none))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; debug info and debug menu
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define *coop-show-info* #f)

(defun coop-slot-status-string ((slot int))
  (let ((status (pc-coop-slot-status slot)))
    (case (logand status 3)
      ((1) (if (logtest? status 4) "keyboard/mouse" "keyboard/mouse (?)"))
      ((2) (if (logtest? status 4) "controller" "controller DISCONNECTED"))
      (else (if (logtest? status 8) "press a button to join" "no device")))))

(defun coop-print-info ()
  "Debug overlay: proves one simulation tick per frame and shows the device assignment."
  (format *stdcon* "~1kco-op: ~A  split: ~A  views last frame: ~D~%" (coop-active?) (-> *coop* split?) (-> *coop-frame* views))
  (format *stdcon* "~1kticks: ~D  view-2 passes: ~D~%" (-> *coop* sim-ticks) (-> *coop* render-passes))
  (dotimes (i COOP_MAX_PLAYERS)
    (let ((tgt (coop-player-target i)))
      (format *stdcon* "~1kP~D ~S: " (+ i 1) (coop-slot-status-string i))
      (if tgt
        (format *stdcon* "~1k~M ~M ~M hp ~f ~A~%"
                (-> tgt control trans x)
                (-> tgt control trans y)
                (-> tgt control trans z)
                (-> tgt fact health)
                (if (-> tgt state) (-> tgt state name) 'none))
        (format *stdcon* "~1k(none)~%"))))
  (none))

(defun coop-toggle-layout ()
  (set! (-> *coop* layout)
        (if (= (-> *coop* layout) (coop-split-layout side-by-side)) (coop-split-layout top-bottom) (coop-split-layout side-by-side)))
  (set! (-> *coop* top-bottom?) (= (-> *coop* layout) (coop-split-layout top-bottom)))
  (none))

(defun coop-respawn-player2-near-player1 ()
  (let ((p1 (coop-player-target 0)))
    (when (and (coop-active?) p1)
      (coop-despawn-player2)
      (coop-spawn-player2 (coop-safe-position-near p1 (new 'stack-no-clear 'vector)))))
  (none))
